'use strict';

import { cursor } from 'uci';
import { popen } from 'fs';
import { connect } from 'ubus';


const MAX_CONFIG_SIZE = 65536;
const AUTO_CONFIG = 'awg-warp-auto';
const AUTO_MAIN = 'main';
const AUTO_POOL = '/etc/awg-warp-auto/pool';
const AUTO_GENERATED = '/tmp/awg-warp-auto/generated';
const AUTO_LOCK = '/var/run/awg-warp-auto.lock';
let import_busy = false;
let auto_busy = false;


function shellquote(s) {
	return `'${replace(s ?? '', "'", "'\\''")}'`;
}

function command(cmd) {
	return trim(popen(cmd)?.read?.('all'));
}

function checkPeerHost(configHost, configPort, wgHost) {
	const ips = popen(`resolveip ${shellquote(configHost)} 2>/dev/null`);
	const hostIp = replace(wgHost, /\[|\]/g, "");
	if (ips) {
		for (let line = ips.read('line'); length(line); line = ips.read('line')) {
			const ip = rtrim(line, '\n');
			if (configPort && (ip + ":" + configPort == hostIp)) {
				return true;
			} else if (ip == substr(hostIp, 0, rindex(hostIp, ":"))) {
				return true;
			}
		}
	}
	return false;
}

function failure(message) {
	return { ok: false, error: message };
}

function validAutoId(id) {
	return type(id) == 'string' && match(id, /^p_[0-9a-f]{16,64}$/i);
}

function autoPath(id) {
	return `${AUTO_POOL}/${id}.conf`;
}

function autoOperationLocked() {
	return command(`test -d ${shellquote(AUTO_LOCK)} && echo locked`) == 'locked';
}

function autoNumber(value, fallback, minimum, maximum) {
	if (type(value) != 'string' && type(value) != 'number') return fallback;
	value = '' + value;
	if (!match(value, /^[0-9]+$/)) return fallback;
	value = +value;
	return value >= minimum && value <= maximum ? value : fallback;
}

function autoBool(value) {
	return value == true || value == 1 || value == '1';
}

function validInterfaceName(value) {
	value = trim(value ?? '');
	return match(value, /^[A-Za-z][A-Za-z0-9_]{0,14}$/) ? value : null;
}

function targetInterface() {
	const uci = cursor();
	if (!uci.load(AUTO_CONFIG)) return 'awg_warp';
	const main = uci.get_all(AUTO_CONFIG, AUTO_MAIN) ?? {};
	return validInterfaceName(main.interface) ?? 'awg_warp';
}

function peerSectionFor(uci, iface) {
	let peer = null;
	uci.foreach('network', `amneziawg_${iface}`, (entry) => {
		if (peer == null) peer = entry['.name'];
	});
	return peer;
}

function managedPeerSection(iface) {
	return `warp_auto_peer_${lc(iface)}`;
}

function knownAwgInterfaces() {
	const uci = cursor();
	let interfaces = [];
	if (!uci.load('network')) return interfaces;
	uci.foreach('network', 'interface', (entry) => {
		const name = validInterfaceName(entry['.name']);
		if (name && entry.proto == 'amneziawg') push(interfaces, name);
	});
	return interfaces;
}

function autoHealthMode(value, fallback) {
	value = lc(trim(value ?? ''));
	return value == 'direct' || value == 'strict' ? value : fallback;
}

function autoLogLevel(value, fallback) {
	value = lc(trim(value ?? ''));
	return value == 'debug' || value == 'info' || value == 'warning' || value == 'error' ? value : fallback;
}

function autoHostname(value) {
	value = lc(trim(value ?? ''));
	if (!match(value, /^[a-z0-9.-]{1,253}$/) || !match(substr(value, 0, 1), /^[a-z0-9]$/) ||
		!match(substr(value, -1), /^[a-z0-9]$/) || index(value, '..') >= 0)
		return null;
	return value;
}

function autoResources(value) {
	let values = [];
	if (type(value) == 'string')
		value = split(value, ',');
	if (type(value) != 'array')
		return null;
	for (let item in value) {
		const host = autoHostname('' + item);
		if (!host || length(values) >= 5) return null;
		let duplicate = false;
		for (let seen in values)
			if (seen == host) duplicate = true;
		if (!duplicate) push(values, host);
	}
	return length(values) ? values : [ 'youtube.com' ];
}

function autoResolvers(value) {
	let values = [];
	if (type(value) == 'string')
		value = split(value, /[\s,]+/);
	if (type(value) != 'array')
		return [ '1.1.1.1', '8.8.8.8', '9.9.9.9', '77.88.8.8', '77.88.8.1' ];
	for (let item in value) {
		item = trim('' + item);
		if (match(item, /^[0-9.]+$|^[0-9a-fA-F:]+$/) && length(values) < 8) {
			let duplicate = false;
			for (let seen in values)
				if (seen == item) duplicate = true;
			if (!duplicate) push(values, item);
		}
	}
	return length(values) ? values : [ '1.1.1.1', '8.8.8.8', '9.9.9.9', '77.88.8.8', '77.88.8.1' ];
}

function autoSourceUrl(value) {
	value = trim(value ?? '');
	if (lc(substr(value, 0, 8)) != 'https://')
		return null;
	for (let i = 0; i < length(value); i++)
		if (index('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-:[]/?&=_%#', substr(value, i, 1)) < 0)
			return null;
	let end = length(value);
	for (let delimiter in [ '/', '?', '#' ]) {
		const relative = index(substr(value, 8), delimiter);
		const found = relative < 0 ? -1 : relative + 8;
		if (found >= 0 && found < end) end = found;
	}
	const authority = substr(value, 8, end - 8);
	if (!length(authority) || index(authority, '@') >= 0) return null;
	let host = lc(replace(authority, /:\d+$/, ''));
	if (substr(host, 0, 1) == '[')
		host = substr(host, 1, index(host, ']') - 1);
	if (!length(host) || host == 'localhost' || host == '::1' || host == '::' ||
		match(host, /^(0|10|127)\./) || match(host, /^169\.254\./) ||
		match(host, /^192\.168\./) || match(host, /^172\.(1[6-9]|2[0-9]|3[0-1])\./) ||
		match(host, /^(fc|fd|fe80:)/i))
		return null;
	return value;
}

function autoReadStored(id) {
	if (!validAutoId(id)) return null;
	const path = autoPath(id);
	const text = command(`cat ${shellquote(path)} 2>/dev/null`);
	return length(text) ? text : null;
}

function autoEntry(uci, id) {
	return validAutoId(id) ? uci.get_all(AUTO_CONFIG, id) : null;
}

function parseList(value, field, requirePrefix) {
	const result = [];
	for (let item in split(value, ',')) {
		item = trim(item);
		if (!length(item) || !match(item, /^[0-9A-Fa-f:.]+(\/[0-9]{1,3})?$/))
			return failure(`Invalid ${field}`);
		if (requirePrefix && index(item, '/') < 0)
			return failure(`${field} entries must include a prefix`);
		if (!requirePrefix && index(item, '/') < 0)
			item += index(item, ':') >= 0 ? '/128' : '/32';
		push(result, item);
	}

	return { ok: true, values: result };
}

function parseEndpoint(value) {
	let host, port;

	if (substr(value, 0, 1) == '[') {
		const end = index(value, ']');
		if (end < 2 || substr(value, end + 1, 1) != ':')
			return failure('Endpoint must be host:port or [IPv6]:port');
		host = substr(value, 1, end - 1);
		port = substr(value, end + 2);
	}
	else {
		const colon = rindex(value, ':');
		if (colon < 1)
			return failure('Endpoint must include a port');
		host = substr(value, 0, colon);
		port = substr(value, colon + 1);
	}

	if (!length(host) || length(host) > 253 || !match(port, /^[0-9]+$/) || +port < 1 || +port > 65535)
		return failure('Invalid endpoint');

	return { ok: true, host, port };
}

function parseAwgConfig(text, filename) {
	if (type(text) != 'string' || !length(text))
		return failure('Choose a non-empty AmneziaWG configuration');
	if (length(text) > MAX_CONFIG_SIZE)
		return failure('Configuration is larger than 64 KiB');
	if (index(text, '\0') >= 0)
		return failure('Configuration contains a NUL byte');

	text = replace(text, /^\uFEFF/, '');
	text = replace(text, /\r\n?/g, '\n');

	const sections = { interface: {}, peer: {} };
	const seen = { interface: 0, peer: 0 };
	let current = null;

	for (let raw in split(text, '\n')) {
		const line = trim(raw);
		if (!length(line) || substr(line, 0, 1) == '#' || substr(line, 0, 1) == ';')
			continue;

		if (substr(line, 0, 1) == '[' && substr(line, -1) == ']') {
			const name = lc(trim(substr(line, 1, length(line) - 2)));
			if (name != 'interface' && name != 'peer')
				return failure(`Unsupported section [${name}]`);
			if (++seen[name] != 1)
				return failure(`Duplicate [${name}] section`);
			current = name;
			continue;
		}

		const equals = index(line, '=');
		if (!current || equals < 1)
			return failure('Malformed line in configuration');

		const key = lc(trim(substr(line, 0, equals)));
		const value = trim(substr(line, equals + 1));
		if (!length(key) || !length(value))
			return failure('Empty option name or value');
		if (sections[current][key] != null)
			return failure(`Duplicate option ${key}`);
		sections[current][key] = value;
	}

	if (seen.interface != 1 || seen.peer != 1)
		return failure('Configuration must contain one [Interface] and one [Peer]');

	const allowedInterface = {
		privatekey: true, address: true, dns: true, mtu: true, listenport: true,
		s1: true, s2: true, s3: true, s4: true, jc: true, jmin: true, jmax: true,
		h1: true, h2: true, h3: true, h4: true,
		i1: true, i2: true, i3: true, i4: true, i5: true
	};
	const allowedPeer = {
		publickey: true, presharedkey: true, allowedips: true, endpoint: true,
		persistentkeepalive: true
	};
	for (let key in sections.interface)
		if (!allowedInterface[key]) return failure(`Unsupported Interface option ${key}`);
	for (let key in sections.peer)
		if (!allowedPeer[key]) return failure(`Unsupported Peer option ${key}`);

	const requiredInterface = [
		'privatekey', 'address', 'mtu', 's1', 's2', 's3', 's4',
		'jc', 'jmin', 'jmax', 'h1', 'h2', 'h3', 'h4'
	];
	const requiredPeer = [ 'publickey', 'allowedips', 'endpoint' ];
	for (let key in requiredInterface)
		if (!sections.interface[key]) return failure(`Missing Interface option ${key}`);
	for (let key in requiredPeer)
		if (!sections.peer[key]) return failure(`Missing Peer option ${key}`);

	for (let field in [ 'privatekey', 'publickey' ]) {
		const value = field == 'privatekey' ? sections.interface[field] : sections.peer[field];
		if (!match(value, /^[A-Za-z0-9+\/]{43}=$/))
			return failure(`Invalid ${field}`);
	}
	if (sections.peer.presharedkey && !match(sections.peer.presharedkey, /^[A-Za-z0-9+\/]{43}=$/))
		return failure('Invalid presharedkey');

	const addresses = parseList(sections.interface.address, 'Address', false);
	if (!addresses.ok) return addresses;
	const allowedIps = parseList(sections.peer.allowedips, 'AllowedIPs', true);
	if (!allowedIps.ok) return allowedIps;
	const endpoint = parseEndpoint(sections.peer.endpoint);
	if (!endpoint.ok) return endpoint;

	if (!match(sections.interface.mtu, /^[0-9]+$/) || +sections.interface.mtu < 576 || +sections.interface.mtu > 9000)
		return failure('MTU must be between 576 and 9000');
	for (let field in [ 's1', 's2', 's3', 's4', 'jc', 'jmin', 'jmax', 'h1', 'h2', 'h3', 'h4' ])
		if (!match(sections.interface[field], /^[0-9]+$/) || +sections.interface[field] > 4294967295)
			return failure(`Invalid numeric option ${field}`);
	if (+sections.interface.jmin > +sections.interface.jmax)
		return failure('Jmin must not be greater than Jmax');
	if (sections.peer.persistentkeepalive && (!match(sections.peer.persistentkeepalive, /^[0-9]+$/) || +sections.peer.persistentkeepalive > 65535))
		return failure('Invalid PersistentKeepalive');

	const iFields = [];
	for (let field in [ 'i1', 'i2', 'i3', 'i4', 'i5' ]) {
		const value = sections.interface[field];
		if (value != null) {
			if (length(value) > 16384 || match(value, /[^\x20-\x7e]/))
				return failure(`${field} is too large or contains non-printable data`);
			push(iFields, { name: field, length: length(value) });
		}
	}

	let profile = replace(filename ?? 'Imported profile', /^.*[\\\/]/, '');
	profile = replace(profile, /[.]conf$/, '');
	profile = replace(profile, /[^A-Za-z0-9_.-]/g, '_');
	if (!length(profile)) profile = 'Imported_profile';
	profile = substr(profile, 0, 64);

	return {
		ok: true,
		profile,
		interface: sections.interface,
		peer: sections.peer,
		addresses: addresses.values,
		allowed_ips: allowedIps.values,
		endpoint,
		i_fields: iFields,
		warnings: [ 'DNS and ListenPort from the file are ignored' ]
	};
}

function restoreSection(uci, name, snapshot) {
	uci.delete('network', name);
	if (!snapshot) return;
	uci.set('network', name, snapshot['.type']);
	for (let key in snapshot)
		if (substr(key, 0, 1) != '.') uci.set('network', name, key, snapshot[key]);
}

function interfaceTopology(iface) {
	iface = validInterfaceName(iface) ?? targetInterface();
	const uci = cursor();
	uci.load('network');
	const interfaceSection = uci.get_all('network', iface);
	const peer = peerSectionFor(uci, iface);
	const has_interface = type(interfaceSection) == 'object' && interfaceSection['.type'] != null;
	const has_peer = peer != null;
	return {
		state: has_interface && has_peer ? 'present' : has_interface || has_peer ? 'partial' : 'missing',
		has_interface, has_peer
	};
}

function activateAwg(iface) {
	iface = validInterfaceName(iface) ?? targetInterface();
	const bus = connect();
	if (!bus) return false;
	bus.call(`network.interface.${iface}`, 'down', {});
	bus.call('network', 'reload', {});
	bus.call(`network.interface.${iface}`, 'up', {});
	for (let attempt = 0; attempt < 8; attempt++) {
		const status = bus.call(`network.interface.${iface}`, 'status', {});
		if (status?.available == true && status?.up == true) return true;
		command('sleep 1');
	}
	return false;
}

function runtimeHealthCheck(mode, iface) {
	iface = validInterfaceName(iface) ?? targetInterface();
	let timeout = 10;
	let resources = [ 'youtube.com' ];
	let attempts = 2;
	let resolvers = '1.1.1.1 8.8.8.8 9.9.9.9 77.88.8.8 77.88.8.1';
	mode = autoHealthMode(mode, 'strict');
	const uci = cursor();
	if (uci.load(AUTO_CONFIG)) {
		const main = uci.get_all(AUTO_CONFIG, AUTO_MAIN);
		if (main) {
			timeout = autoNumber(main.health_timeout, 10, 3, 30);
			attempts = 1 + autoNumber(main.health_retries, 1, 0, 4);
			const parsed = autoResources(main.critical_resource ?? [ 'youtube.com' ]);
			if (parsed) resources = parsed;
			resolvers = join(' ', autoResolvers(main.health_resolvers));
		}
	}
	/* netifd and the policy proxy may lag the interface by a few seconds. */
	let result = 'no health-check result';
	for (let attempt = 0; attempt < attempts; attempt++) {
		result = command(`sleep 2; /usr/libexec/awg-warp-auto/health-check.sh ${shellquote(iface)} ${timeout} ${shellquote(join(resources, ','))} ${mode} ${shellquote(resolvers)} 2>/dev/null`);
		if (match(result, /^OK [0-9]+$/))
			return { ok: true, detail: result };
	}
	return { ok: false, detail: length(result) ? result : 'no health-check result' };
}

function autoStageFile(path, filename) {
	if (type(path) != 'string' || !match(path, /^\/tmp\/awg-warp-auto\/generated\/[A-Za-z0-9_.-]+\.conf$/))
		return failure('Invalid generated candidate path');
	const text = command(`cat ${shellquote(path)} 2>/dev/null`);
	if (!length(text)) return failure('Generated candidate is missing');
	const parsed = parseAwgConfig(text, filename);
	if (!parsed.ok) {
		command(`rm -f ${shellquote(path)}`);
		return failure(`Generated candidate is invalid: ${parsed.error}`);
	}
	const digest = command(`sha256sum ${shellquote(path)} 2>/dev/null | awk '{print $1}'`);
	if (!match(digest, /^[0-9a-f]{64}$/i)) {
		command(`rm -f ${shellquote(path)}`);
		return failure('Unable to fingerprint generated candidate');
	}
	const id = `p_${substr(digest, 0, 24)}`;
	const uci = cursor();
	uci.load(AUTO_CONFIG);
	const existing = autoEntry(uci, id);
	if (existing) {
		command(`rm -f ${shellquote(path)}`);
		return {
			ok: true, id, existing: true, profile: existing.profile,
			endpoint: existing.endpoint, status: existing.status
		};
	}

	command(`mkdir -p ${shellquote(AUTO_POOL)} && chmod 700 '/etc/awg-warp-auto' ${shellquote(AUTO_POOL)}`);
	command(`cp ${shellquote(path)} ${shellquote(autoPath(id))} && chmod 600 ${shellquote(autoPath(id))}`);
	command(`rm -f ${shellquote(path)}`);
	const check = command(`test -s ${shellquote(autoPath(id))} && echo OK`);
	if (check != 'OK') return failure('Unable to protect generated candidate');

	uci.set(AUTO_CONFIG, id, 'entry');
	uci.set(AUTO_CONFIG, id, 'fingerprint', digest);
	uci.set(AUTO_CONFIG, id, 'profile', parsed.profile);
	uci.set(AUTO_CONFIG, id, 'endpoint', `${parsed.endpoint.host}:${parsed.endpoint.port}`);
	uci.set(AUTO_CONFIG, id, 'status', 'NEW');
	uci.set(AUTO_CONFIG, id, 'created_at', command('date +%s'));
	uci.set(AUTO_CONFIG, id, 'failure_count', '0');
	if (!uci.commit(AUTO_CONFIG)) return failure('Unable to save candidate metadata');
	return { ok: true, id, profile: parsed.profile, endpoint: `${parsed.endpoint.host}:${parsed.endpoint.port}`, status: 'NEW' };
}

function autoProbeCandidate(id, timeout) {
	const text = autoReadStored(id);
	if (!text) return failure('Candidate configuration is missing');
	const parsed = parseAwgConfig(text, `${id}.conf`);
	if (!parsed.ok) return failure('Candidate configuration is invalid');
	timeout = autoNumber(timeout, 10, 3, 30);
	const uci = cursor();
	let resolvers = '1.1.1.1 8.8.8.8 9.9.9.9 77.88.8.8 77.88.8.1';
	if (uci.load(AUTO_CONFIG)) {
		const main = uci.get_all(AUTO_CONFIG, AUTO_MAIN);
		if (main) resolvers = join(' ', autoResolvers(main.health_resolvers));
	}
	const result = command(`/usr/libexec/awg-warp-auto/candidate-test.sh ${shellquote(autoPath(id))} ${timeout} 51822 ${shellquote(resolvers)} 2>/dev/null`);
	if (!match(result, /^OK [0-9]+$/)) return failure('Candidate YouTube probe failed');
	return { ok: true, latency_ms: +substr(result, 3) };
}

function autoHealth(timeout, resources, mode) {
	timeout = autoNumber(timeout, 10, 3, 30);
	resources = autoResources(resources);
	mode = autoHealthMode(mode, 'strict');
	if (!resources) return failure('Invalid critical resource list');
	const uci = cursor();
	let resolvers = '1.1.1.1 8.8.8.8 9.9.9.9 77.88.8.8 77.88.8.1';
	if (uci.load(AUTO_CONFIG)) {
		const main = uci.get_all(AUTO_CONFIG, AUTO_MAIN);
		if (main) resolvers = join(' ', autoResolvers(main.health_resolvers));
	}
	const result = command(`/usr/libexec/awg-warp-auto/health-check.sh ${shellquote(targetInterface())} ${timeout} ${shellquote(join(resources, ','))} ${mode} ${shellquote(resolvers)} 2>/dev/null`);
	if (!match(result, /^OK [0-9]+$/)) return failure('Active YouTube health check failed');
	return { ok: true, latency_ms: +substr(result, 3) };
}

function autoStatus() {
	const uci = cursor();
	uci.load(AUTO_CONFIG);
	const main = uci.get_all(AUTO_CONFIG, AUTO_MAIN) ?? {};
	const target = targetInterface();
	const topology = interfaceTopology(target);
	const settings = {
		interface: target,
		enabled: autoBool(main.enabled),
		automatic_failover: autoBool(main.automatic_failover ?? '1'),
		failover_cooldown: autoNumber(main.failover_cooldown, 10, 5, 3600),
		provider: main.provider == 'native' ? 'native' : 'remote',
		source_url: main.source_url ?? 'https://warp-generation.github.io',
		native_sni: main.native_sni ?? '',
		native_quic_mode: main.native_quic_mode == 'dynamic' ? 'dynamic' : 'fallback',
		native_endpoint_mode: main.native_endpoint_mode == 'custom' ? 'custom' : (main.native_endpoint_mode == 'auto_custom' ? 'auto_custom' : 'auto'),
		native_batch_limit: autoNumber(main.native_batch_limit, 2, 1, 2),
		native_min_interval: autoNumber(main.native_min_interval, 900, 60, 86400),
		native_endpoints: main.native_endpoint ?? [],
		refresh_interval: autoNumber(main.refresh_interval, 86400, 300, 604800),
		minimum_ready: autoNumber(main.minimum_ready, 2, 1, 8),
		health_interval: autoNumber(main.health_interval, 60, 5, 3600),
		health_timeout: autoNumber(main.health_timeout, 10, 3, 30),
		failure_threshold: autoNumber(main.failure_threshold, 3, 1, 10),
		health_mode: autoHealthMode(main.health_mode, topology.state == 'missing' ? 'direct' : 'strict'),
		log_level: autoLogLevel(main.log_level, 'info'),
		critical_resource: autoResources(main.critical_resource ?? [ 'youtube.com' ]) ?? [ 'youtube.com' ],
		health_resolvers: join(' ', autoResolvers(main.health_resolvers))
	};
	const pool = [];
	let active_health = '';
	let active_failures = 0;
	let active_last_health = 0;
	uci.foreach(AUTO_CONFIG, 'entry', (entry) => {
		const id = entry['.name'];
		if (!validAutoId(id)) return;
		const is_active = main.active_id == id;
		const failure_count = autoNumber(entry.failure_count, 0, 0, 999);
		if (is_active) {
			active_health = entry.health_state ?? (entry.last_health ? 'OK' : 'not checked');
			active_failures = failure_count;
			active_last_health = autoNumber(entry.last_health, 0, 0, 4294967295);
		}
		push(pool, {
			id, profile: entry.profile ?? id, endpoint: entry.endpoint ?? '',
			status: entry.status ?? 'NEW', created_at: autoNumber(entry.created_at, 0, 0, 4294967295),
			last_test: autoNumber(entry.last_test, 0, 0, 4294967295),
			last_health: autoNumber(entry.last_health, 0, 0, 4294967295),
			latency_ms: autoNumber(entry.latency_ms, 0, 0, 120000),
			failure_count,
			blacklist_until: autoNumber(entry.blacklist_until, 0, 0, 4294967295),
			source_provider: entry.source_provider ?? 'unknown',
			endpoint_source: entry.endpoint_source ?? '',
			source_url: entry.source_url ?? '',
			last_error: entry.last_error ?? '',
			active: is_active
		});
	});
	const bus = connect();
	const iface = bus ? bus.call(`network.interface.${target}`, 'status', {}) : null;
	const daemon = command("ubus call service list '{\"name\":\"awg-warp-auto\"}' 2>/dev/null | grep -Eq '\"running\"[[:space:]]*:[[:space:]]*true' && echo running || echo stopped");
	const runtime = {
		interface: target,
		available_interfaces: knownAwgInterfaces(),
		interface_state: topology.state,
		service: autoBool(main.enabled) ? daemon : 'disabled',
		available: iface?.available == true,
		up: iface?.up == true,
		active_id: main.active_id ?? '',
		previous_active_id: main.previous_active_id ?? '',
		health: active_health,
		last_health: active_last_health,
		consecutive_failures: active_failures,
		last_refresh: autoNumber(main.last_refresh, 0, 0, 4294967295),
		last_failover: autoNumber(main.last_failover, 0, 0, 4294967295),
		bootstrap_state: main.bootstrap_state ?? '',
		bootstrap_error: main.bootstrap_error ?? '',
		bootstrap_updated: autoNumber(main.bootstrap_updated, 0, 0, 4294967295)
	};
	const raw_logs = command("logread -e awg-warp-auto 2>/dev/null | tail -n 50");
	return { ok: true, settings, runtime, pool, logs: length(raw_logs) ? split(raw_logs, '\n') : [] };
}

function saveAutoSettings(settings, defer_service) {
	if (type(settings) != 'object') return failure('Invalid WARP Auto settings');
	const source = autoSourceUrl(settings.source_url);
	const resources = autoResources(settings.critical_resource);
	const iface = validInterfaceName(settings.interface);
	if (!source) return failure('Source URL must be a safe absolute HTTPS URL');
	if (!resources) return failure('Critical resources must be host names');
	if (!iface) return failure('Interface name must use letters, digits, or underscores and be at most 15 characters');
	const values = {
		interface: iface,
		enabled: autoBool(settings.enabled) ? '1' : '0',
		automatic_failover: autoBool(settings.automatic_failover) ? '1' : '0',
		failover_cooldown: '' + autoNumber(settings.failover_cooldown, 10, 5, 3600),
		provider: settings.provider == 'native' ? 'native' : 'remote',
		source_url: source,
		native_sni: match(settings.native_sni ?? '', /^[A-Za-z0-9.-]{0,253}$/) ? (settings.native_sni ?? '') : '',
		native_quic_mode: settings.native_quic_mode == 'dynamic' ? 'dynamic' : 'fallback',
		native_endpoint_mode: settings.native_endpoint_mode == 'custom' ? 'custom' : (settings.native_endpoint_mode == 'auto_custom' ? 'auto_custom' : 'auto'),
		native_batch_limit: '' + autoNumber(settings.native_batch_limit, 2, 1, 2),
		native_min_interval: '' + autoNumber(settings.native_min_interval, 900, 60, 86400),
		refresh_interval: '' + autoNumber(settings.refresh_interval, 86400, 300, 604800),
		minimum_ready: '' + autoNumber(settings.minimum_ready, 2, 1, 8),
		health_interval: '' + autoNumber(settings.health_interval, 60, 5, 3600),
		health_timeout: '' + autoNumber(settings.health_timeout, 10, 3, 30),
		failure_threshold: '' + autoNumber(settings.failure_threshold, 3, 1, 10),
		health_mode: autoHealthMode(settings.health_mode, 'strict'),
		log_level: autoLogLevel(settings.log_level, 'info'),
		health_resolvers: join(' ', autoResolvers(settings.health_resolvers))
	};
	const uci = cursor();
	uci.load(AUTO_CONFIG);
	uci.set(AUTO_CONFIG, AUTO_MAIN, 'awg_warp_auto');
	for (let name in values) uci.set(AUTO_CONFIG, AUTO_MAIN, name, values[name]);
	uci.set(AUTO_CONFIG, AUTO_MAIN, 'critical_resource', resources);
	const submitted_endpoints = settings.native_endpoints ?? settings.native_endpoint;
	uci.delete(AUTO_CONFIG, AUTO_MAIN, 'native_endpoint');
	if (type(submitted_endpoints) == 'array') {
		const endpoints = filter(submitted_endpoints, (v) => type(v) == 'string' && match(v, /^[A-Za-z0-9.-]+:[0-9]{1,5}$/));
		if (length(endpoints)) uci.set(AUTO_CONFIG, AUTO_MAIN, 'native_endpoint', endpoints);
	}
	if (!uci.commit(AUTO_CONFIG)) return failure('Unable to save WARP Auto settings');
	if (defer_service) return autoStatus();
	if (values.enabled == '1')
		command('/etc/init.d/awg-warp-auto enable; /etc/init.d/awg-warp-auto restart');
	else
		command('/etc/init.d/awg-warp-auto stop; /etc/init.d/awg-warp-auto disable');
	return autoStatus();
}

function applyParsedConfig(parsed, health_mode, iface) {
	health_mode = autoHealthMode(health_mode, 'strict');
	iface = validInterfaceName(iface) ?? targetInterface();
	const uci = cursor();
	uci.load('network');
	const peerSection = peerSectionFor(uci, iface);
	const managedPeer = managedPeerSection(iface);
	const oldInterface = uci.get_all('network', iface);
	const oldPeer = peerSection ? uci.get_all('network', peerSection) : null;

	uci.delete('network', iface);
	if (peerSection) uci.delete('network', peerSection);
	if (managedPeer != peerSection) uci.delete('network', managedPeer);
	uci.set('network', iface, 'interface');
	uci.set('network', iface, 'proto', 'amneziawg');
	uci.set('network', iface, 'private_key', parsed.interface.privatekey);
	uci.set('network', iface, 'listen_port', '51821');
	/* 0x08000000 belongs to the existing Forkop/YT policy rule. Reusing it
	 * marks AWG's outer UDP and routes it back into the same tunnel. */
	uci.set('network', iface, 'fwmark', '0x01000000');
	uci.set('network', iface, 'mtu', parsed.interface.mtu);
	uci.set('network', iface, 'addresses', parsed.addresses);
	for (let field in [ 'jc', 'jmin', 'jmax', 's1', 's2', 's3', 's4', 'h1', 'h2', 'h3', 'h4', 'i1', 'i2', 'i3', 'i4', 'i5' ])
		if (parsed.interface[field] != null) uci.set('network', iface, `awg_${field}`, parsed.interface[field]);

	uci.set('network', managedPeer, `amneziawg_${iface}`);
	uci.set('network', managedPeer, 'description', parsed.profile);
	uci.set('network', managedPeer, 'public_key', parsed.peer.publickey);
	uci.set('network', managedPeer, 'route_allowed_ips', '0');
	uci.set('network', managedPeer, 'endpoint_host', parsed.endpoint.host);
	uci.set('network', managedPeer, 'endpoint_port', parsed.endpoint.port);
	uci.set('network', managedPeer, 'allowed_ips', parsed.allowed_ips);
	if (parsed.peer.presharedkey) uci.set('network', managedPeer, 'preshared_key', parsed.peer.presharedkey);
	if (parsed.peer.persistentkeepalive) uci.set('network', managedPeer, 'persistent_keepalive', parsed.peer.persistentkeepalive);

	if (!uci.commit('network')) {
		restoreSection(uci, iface, oldInterface);
		restoreSection(uci, managedPeer, oldPeer);
		uci.commit('network');
		return failure('Unable to commit network configuration');
	}

	const activated = activateAwg(iface);
	const health = activated ? runtimeHealthCheck(health_mode, iface) : { ok: false, detail: 'interface did not become available' };
	if (activated && health.ok)
		return { ok: true, profile: parsed.profile, endpoint: `${parsed.endpoint.host}:${parsed.endpoint.port}` };

	const rollback = cursor();
	rollback.load('network');
	restoreSection(rollback, iface, oldInterface);
	restoreSection(rollback, managedPeer, oldPeer);
	rollback.commit('network');
	activateAwg(iface);
	return failure(`Health check failed (${health.detail}); the previous profile was restored`);
}

const methods = {
	getWarpAutoStatus: {
		call: function() {
			return autoStatus();
		}
	},

	saveWarpAutoSettings: {
		args: { settings: {}, defer_service: 'defer_service' },
		call: function(req) {
			if (auto_busy) return failure('Another WARP Auto operation is already running');
			auto_busy = true;
			const result = saveAutoSettings(req.args?.settings, autoBool(req.args?.defer_service));
			auto_busy = false;
			return result;
		}
	},

	warpAutoAction: {
		args: { action: 'action', id: 'id' },
		call: function(req) {
			if (auto_busy) return failure('Another WARP Auto operation is already running');
			const action = req.args?.action;
			const id = req.args?.id;
			let command_line = null;
			if (action == 'refresh') command_line = '/usr/libexec/awg-warp-auto/daemon.sh refresh';
			else if (action == 'test_all') command_line = '/usr/libexec/awg-warp-auto/daemon.sh test_all';
			else if (action == 'rollback') command_line = '/usr/libexec/awg-warp-auto/daemon.sh rollback';
			else if (action == 'native_test') command_line = '/usr/libexec/awg-warp-auto/daemon.sh native_test';
			else if (action == 'force_replenish') command_line = '/usr/libexec/awg-warp-auto/daemon.sh force_replenish';
			else if (action == 'retest' && validAutoId(id)) command_line = `/usr/libexec/awg-warp-auto/daemon.sh retest ${id}`;
			else if (action == 'bootstrap') {
				const status = cursor();
				status.load(AUTO_CONFIG);
				if (status.get(AUTO_CONFIG, AUTO_MAIN, 'bootstrap_state') == 'running')
					return failure('Initial WARP setup is already running');
				const target = targetInterface();
				const topology = interfaceTopology(target);
				if (topology.state == 'present') return failure(`${target} already exists; use the pool controls instead`);
				if (topology.state == 'partial') return failure(`${target} configuration is incomplete; repair it before creating a new interface`);
				/* A requested bootstrap owns the first activation. Stop any pre-enabled
				 * daemon before it can race this foreground setup job. */
				command('/etc/init.d/awg-warp-auto stop >/dev/null 2>&1');
				command_line = '/usr/libexec/awg-warp-auto/daemon.sh bootstrap';
			}
			else if (action == 'activate' && validAutoId(id)) command_line = `/usr/libexec/awg-warp-auto/daemon.sh activate ${id}`;
			else return failure('Invalid WARP Auto action');
			auto_busy = true;
			command(`${command_line} >/dev/null 2>&1 &`);
			auto_busy = false;
			return { ok: true, started: true, action, id: validAutoId(id) ? id : null };
		}
	},

	stageWarpAutoFile: {
		args: { path: 'path', filename: 'filename' },
		call: function(req) {
			if (auto_busy) return failure('Another WARP Auto operation is already running');
			auto_busy = true;
			const result = autoStageFile(req.args?.path, req.args?.filename);
			auto_busy = false;
			return result;
		}
	},

	testWarpAutoCandidate: {
		args: { id: 'id', timeout: 'timeout' },
		call: function(req) {
			return autoProbeCandidate(req.args?.id, req.args?.timeout);
		}
	},

	activateWarpAutoCandidate: {
		args: { id: 'id', health_mode: 'health_mode' },
		call: function(req) {
			if (auto_busy || import_busy) return failure('Another profile operation is already running');
			auto_busy = true;
			const health_mode = autoHealthMode(req.args?.health_mode, 'strict');
			if (health_mode == 'direct') {
				const settings = cursor();
				settings.load(AUTO_CONFIG);
				const main = settings.get_all(AUTO_CONFIG, AUTO_MAIN) ?? {};
				if (autoHealthMode(main.health_mode, 'strict') != 'direct') {
					auto_busy = false;
					return failure('Direct health mode is not enabled for WARP Auto');
				}
			}
			const text = autoReadStored(req.args?.id);
			const parsed = text ? parseAwgConfig(text, `${req.args?.id}.conf`) : failure('Candidate configuration is missing');
			const result = parsed.ok ? applyParsedConfig(parsed, health_mode) : parsed;
			auto_busy = false;
			return result;
		}
	},

	getWarpAutoHealth: {
		args: { timeout: 'timeout', resources: 'resources', mode: 'mode' },
		call: function(req) {
			return autoHealth(req.args?.timeout, req.args?.resources, req.args?.mode);
		}
	},

	validateAwgConfig: {
		args: { config: 'config', filename: 'filename' },
		call: function(req) {
			const parsed = parseAwgConfig(req.args?.config, req.args?.filename);
			if (!parsed.ok) return parsed;
			return {
				ok: true,
				profile: parsed.profile,
				addresses: parsed.addresses,
				endpoint: `${parsed.endpoint.host}:${parsed.endpoint.port}`,
				i_fields: parsed.i_fields,
				warnings: parsed.warnings
			};
		}
	},

	importAwgConfig: {
		args: { config: 'config', filename: 'filename' },
		call: function(req) {
			if (import_busy || autoOperationLocked()) return failure('WARP Auto is busy; wait for its current action to finish');
			import_busy = true;
			const parsed = parseAwgConfig(req.args?.config, req.args?.filename);
			if (!parsed.ok) {
				import_busy = false;
				return parsed;
			}
			const result = applyParsedConfig(parsed, 'strict');
			import_busy = false;
			return result;
		}
	},

	generatePsk: {
		call: function() {
			return { psk: command('awg genpsk 2>/dev/null') };
		}
	},

	generateKeyPair: {
		call: function() {
			const priv = command('awg genkey 2>/dev/null');
			const pub = command(`echo ${shellquote(priv)} | awg pubkey 2>/dev/null`);

			return { keys: { priv, pub } };
		}
	},

	getPublicAndPrivateKeyFromPrivate: {
		args: { privkey: "privkey" },
		call: function(req) {
			const priv = req.args?.privkey;
			const pub = command(`echo ${shellquote(priv)} | awg pubkey 2>/dev/null`);

			return { keys: { priv, pub } };
		}
	},

	getAwgInstances: {
		call: function() {
			const data = {};
			let last_device;
			let qr_pubkey = {};

			const uci = cursor();
			const wg_dump = popen("awg show all dump 2>/dev/null");

			if (wg_dump) {
				uci.load("network");

				for (let line = wg_dump.read('line'); length(line); line = wg_dump.read('line')) {
					const record = split(rtrim(line, '\n'), '\t');

					if (last_device != record[0]) {
						last_device = record[0];
						data[last_device] = {
							name: last_device,
							public_key: record[2],
							listen_port: record[3],
							fwmark: record[4],
							peers: []
						};

						if (!length(record[2]) || record[2] == '(none)')
							qr_pubkey[last_device] = '';
						else
							qr_pubkey[last_device] = `PublicKey = ${record[2]}`;
					}
					else {
						let peer_name;
						let peer_name_legacy;

						uci.foreach('network', `amneziawg_${last_device}`, (s) => {
							if (!s.disabled && s.public_key == record[1] && (!s.endpoint_host || checkPeerHost(s.endpoint_host, s.endpoint_port, record[3])))
								peer_name = s.description;
							if (s.public_key == record[1])
								peer_name_legacy = s.description;
						});

						if (!peer_name) peer_name = peer_name_legacy;

						const peer = {
							name: peer_name,
							public_key: record[1],
							endpoint: record[3],
							allowed_ips: [],
							latest_handshake: record[5],
							transfer_rx: record[6],
							transfer_tx: record[7],
							persistent_keepalive: record[8]
						};

						if (record[3] != '(none)' && length(record[4]))
							push(peer.allowed_ips, ...split(record[4], ','));

						push(data[last_device].peers, peer);
					}
				}
			}

			return data;
		}
	}
};

return { 'luci.amneziawg': methods };
