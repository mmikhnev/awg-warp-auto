config awg_warp_auto 'main'
	option enabled '0'
	option automatic_failover '1'
	option source_url 'https://warp-generation.github.io'
	option provider 'remote'
	option native_batch_limit '2'
	option native_min_interval '900'
	option native_backoff_base '300'
	option native_backoff_max '3600'
	option native_next_attempt '0'
	option native_failures '0'
	option native_endpoint_cursor '0'
	option native_last_attempt '0'
	option native_sni 'w3.org'
	option native_quic_mode 'fallback'
	list native_endpoint '8.6.112.6:987'
	list native_endpoint '8.34.70.3:3581'
	list native_endpoint '188.114.98.8:890'
	option interface 'awg_warp'
	option refresh_interval '86400'
	option minimum_ready '2'
	option health_interval '60'
	option health_timeout '10'
	# A new router has no Forkop policy yet. Direct mode proves AWG itself;
	# switch to strict in LuCI after policy routing is configured.
	option health_mode 'direct'
	option health_retries '1'
	option failure_threshold '3'
	option log_level 'info'
	option failover_cooldown '300'
	option blacklist_cooldown '3600'
	list critical_resource 'youtube.com'
