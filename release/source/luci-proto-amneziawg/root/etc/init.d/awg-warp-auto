#!/bin/sh /etc/rc.common

# This scaffold stays inert until the WARP Auto runtime is installed and
# explicitly enabled in /etc/config/awg-warp-auto.
USE_PROCD=1
START=99
STOP=10

PROG='/usr/libexec/awg-warp-auto/daemon.sh'
CONFIG='awg-warp-auto'

start_service() {
	config_load "$CONFIG"

	local enabled
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0

	[ -x "$PROG" ] || {
		logger -t "$CONFIG" 'backend unavailable; service not started'
		return 0
	}

	procd_open_instance
	procd_set_param command "$PROG" run
	procd_set_param respawn 3600 5 5
	procd_set_param file "/etc/config/$CONFIG" "$PROG"
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "$CONFIG"
}
