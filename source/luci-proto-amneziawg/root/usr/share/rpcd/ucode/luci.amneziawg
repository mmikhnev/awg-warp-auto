'use strict';

import { cursor } from 'uci';
import { popen, readfile, writefile, open, stat } from 'fs';
import { connect } from 'ubus';


const MAX_CONFIG_SIZE = 65536;
const AUTO_CONFIG = 'awg-warp-auto';
const AUTO_MAIN = 'main';
const AUTO_POOL = '/etc/awg-warp-auto/pool';
const AUTO_GENERATED = '/tmp/awg-warp-auto/generated';
const AUTO_LOCK = '/var/run/awg-warp-auto.lock';
let import_busy = false;
let auto_busy = false;


function shellquote(s) {
	return `'${replace(s ?? '', "'", "'\\''")}'`;
}

function command(cmd) {
	return trim(popen(cmd)?.read?.('all'));
}

function checkPeerHost(configHost, configPort, wgHost) {
	const ips = popen(`resolveip ${shellquote(configHost)} 2>/dev/null`);
	const hostIp = replace(wgHost, /\[|\]/g, "");
	if (ips) {
		for (let line = ips.read('line'); length(line); line = ips.read('line')) {
			const ip = rtrim(line, '\n');
			if (configPort && (ip + ":" + configPort == hostIp)) {
				return true;
			} else if (ip == substr(hostIp, 0, rindex(hostIp, ":"))) {
				return true;
			}
		}
	}
	return false;
}

function failure(message) {
	return { ok: false, error: message };
}

function validAutoId(id) {
	return type(id) == 'string' && match(id, /^p_[0-9a-f]{16,64}$/i);
}

function autoPath(id) {
	return `${AUTO_POOL}/${id}.conf`;
}

function autoOperationLocked() {
	return command(`test -d ${shellquote(AUTO_LOCK)} && echo locked`) == 'locked';
}

function readActiveOperation() {
	const op_raw = readfile('/tmp/awg-warp-auto/operation.json');
	if (!op_raw) return null;
	let op = null;
	try { op = json(op_raw); } catch(e) {}
	if (!op) return null;

	if (op.status == 'running') {
		let is_dead = false;
		if (op.pid) {
			const st = stat(sprintf('/proc/%d', op.pid));
			if (!st) is_dead = true;
		} else if (op.updated_at && (time() - autoNumber(op.updated_at, 0)) > 60) {
			is_dead = true;
		}

		if (is_dead) {
			op.status = 'failed';
			op.step = 'completed';
			op.error = 'Worker process terminated unexpectedly';
			op.code = 'worker_terminated';
			op.updated_at = time();
			writefile('/tmp/awg-warp-auto/operation.json', sprintf('%J\n', op));
		}
	}
	return op;
}

function autoNumber(value, fallback, minimum, maximum) {
	if (type(value) != 'string' && type(value) != 'int' && type(value) != 'double') return fallback;
	value = '' + value;
	if (!match(value, /^[0-9]+$/)) return fallback;
	value = +value;
	return value >= minimum && value <= maximum ? value : fallback;
}

function autoBool(value) {
	return value == true || value == 1 || value == '1';
}

function validInterfaceName(value) {
	value = trim(value ?? '');
	return match(value, /^[A-Za-z][A-Za-z0-9_]{0,14}$/) ? value : null;
}

function targetInterface() {
	const uci = cursor();
	if (!uci.load(AUTO_CONFIG)) return 'awg_warp';
	const main = uci.get_all(AUTO_CONFIG, AUTO_MAIN) ?? {};
	return validInterfaceName(main.interface) ?? 'awg_warp';
}

function peerSectionFor(uci, iface) {
	let peer = null;
	uci.foreach('network', `amneziawg_${iface}`, (entry) => {
		if (peer == null) peer = entry['.name'];
	});
	return peer;
}

function managedPeerSection(iface) {
	return `warp_auto_peer_${lc(iface)}`;
}

function knownAwgInterfaces() {
	const uci = cursor();
	let interfaces = [];
	if (!uci.load('network')) return interfaces;
	uci.foreach('network', 'interface', (entry) => {
		const name = validInterfaceName(entry['.name']);
		if (name && entry.proto == 'amneziawg') push(interfaces, name);
	});
	return interfaces;
}

function autoHealthMode(value, fallback) {
	value = lc(trim(value ?? ''));
	return value == 'direct' || value == 'strict' ? value : fallback;
}

function autoLogLevel(value, fallback) {
	value = lc(trim(value ?? ''));
	return value == 'debug' || value == 'info' || value == 'warning' || value == 'error' ? value : fallback;
}

function autoHostname(value) {
	value = lc(trim(value ?? ''));
	if (!match(value, /^[a-z0-9.-]{1,253}$/) || !match(substr(value, 0, 1), /^[a-z0-9]$/) ||
		!match(substr(value, -1), /^[a-z0-9]$/) || index(value, '..') >= 0)
		return null;
	return value;
}

function autoResources(value) {
	let values = [];
	if (type(value) == 'string')
		value = split(value, ',');
	if (type(value) != 'array')
		return null;
	for (let item in value) {
		const host = autoHostname('' + item);
		if (!host || length(values) >= 5) return null;
		let duplicate = false;
		for (let seen in values)
			if (seen == host) duplicate = true;
		if (!duplicate) push(values, host);
	}
	return length(values) ? values : [ 'youtube.com' ];
}

function autoResolvers(value) {
	let values = [];
	if (type(value) == 'string')
		value = split(value, /[\s,]+/);
	if (type(value) != 'array')
		return [ '1.1.1.1', '8.8.8.8', '9.9.9.9', '77.88.8.8', '77.88.8.1' ];
	for (let item in value) {
		item = trim('' + item);
		if (match(item, /^[0-9.]+$|^[0-9a-fA-F:]+$/) && length(values) < 8) {
			let duplicate = false;
			for (let seen in values)
				if (seen == item) duplicate = true;
			if (!duplicate) push(values, item);
		}
	}
	return length(values) ? values : [ '1.1.1.1', '8.8.8.8', '9.9.9.9', '77.88.8.8', '77.88.8.1' ];
}

function autoSourceUrl(value) {
	value = trim(value ?? '');
	if (lc(substr(value, 0, 8)) != 'https://')
		return null;
	for (let i = 0; i < length(value); i++)
		if (index('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-:[]/?&=_%#', substr(value, i, 1)) < 0)
			return null;
	let end = length(value);
	for (let delimiter in [ '/', '?', '#' ]) {
		const relative = index(substr(value, 8), delimiter);
		const found = relative < 0 ? -1 : relative + 8;
		if (found >= 0 && found < end) end = found;
	}
	const authority = substr(value, 8, end - 8);
	if (!length(authority) || index(authority, '@') >= 0) return null;
	let host = lc(replace(authority, /:\d+$/, ''));
	if (substr(host, 0, 1) == '[')
		host = substr(host, 1, index(host, ']') - 1);
	if (!length(host) || host == 'localhost' || host == '::1' || host == '::' ||
		match(host, /^(0|10|127)\./) || match(host, /^169\.254\./) ||
		match(host, /^192\.168\./) || match(host, /^172\.(1[6-9]|2[0-9]|3[0-1])\./) ||
		match(host, /^(fc|fd|fe80:)/i))
		return null;
	return value;
}

function autoReadStored(id) {
	if (!validAutoId(id)) return null;
	const path = autoPath(id);
	const text = command(`cat ${shellquote(path)} 2>/dev/null`);
	return length(text) ? text : null;
}

function autoEntry(uci, id) {
	return validAutoId(id) ? uci.get_all(AUTO_CONFIG, id) : null;
}

function parseList(value, field, requirePrefix) {
	const result = [];
	for (let item in split(value, ',')) {
		item = trim(item);
		if (!length(item) || !match(item, /^[0-9A-Fa-f:.]+(\/[0-9]{1,3})?$/))
			return failure(`Invalid ${field}`);
		if (requirePrefix && index(item, '/') < 0)
			return failure(`${field} entries must include a prefix`);
		if (!requirePrefix && index(item, '/') < 0)
			item += index(item, ':') >= 0 ? '/128' : '/32';
		push(result, item);
	}

	return { ok: true, values: result };
}

function parseEndpoint(value) {
	let host, port;

	if (substr(value, 0, 1) == '[') {
		const end = index(value, ']');
		if (end < 2 || substr(value, end + 1, 1) != ':')
			return failure('Endpoint must be host:port or [IPv6]:port');
		host = substr(value, 1, end - 1);
		port = substr(value, end + 2);
	}
	else {
		const colon = rindex(value, ':');
		if (colon < 1)
			return failure('Endpoint must include a port');
		host = substr(value, 0, colon);
		port = substr(value, colon + 1);
	}

	if (!length(host) || length(host) > 253 || !match(port, /^[0-9]+$/) || +port < 1 || +port > 65535)
		return failure('Invalid endpoint');

	return { ok: true, host, port };
}

function parseAwgConfig(text, filename) {
	if (type(text) != 'string' || !length(text))
		return failure('Choose a non-empty AmneziaWG configuration');
	if (length(text) > MAX_CONFIG_SIZE)
		return failure('Configuration is larger than 64 KiB');
	if (index(text, '\0') >= 0)
		return failure('Configuration contains a NUL byte');

	text = replace(text, /^\uFEFF/, '');
	text = replace(text, /\r\n?/g, '\n');

	const sections = { interface: {}, peer: {} };
	const seen = { interface: 0, peer: 0 };
	let current = null;

	for (let raw in split(text, '\n')) {
		const line = trim(raw);
		if (!length(line) || substr(line, 0, 1) == '#' || substr(line, 0, 1) == ';')
			continue;

		if (substr(line, 0, 1) == '[' && substr(line, -1) == ']') {
			const name = lc(trim(substr(line, 1, length(line) - 2)));
			if (name != 'interface' && name != 'peer')
				return failure(`Unsupported section [${name}]`);
			if (++seen[name] != 1)
				return failure(`Duplicate [${name}] section`);
			current = name;
			continue;
		}

		const equals = index(line, '=');
		if (!current || equals < 1)
			return failure('Malformed line in configuration');

		const key = lc(trim(substr(line, 0, equals)));
		const value = trim(substr(line, equals + 1));
		if (!length(key) || !length(value))
			return failure('Empty option name or value');
		if (sections[current][key] != null)
			return failure(`Duplicate option ${key}`);
		sections[current][key] = value;
	}

	if (seen.interface != 1 || seen.peer != 1)
		return failure('Configuration must contain one [Interface] and one [Peer]');

	const allowedInterface = {
		privatekey: true, address: true, dns: true, mtu: true, listenport: true,
		s1: true, s2: true, s3: true, s4: true, jc: true, jmin: true, jmax: true,
		h1: true, h2: true, h3: true, h4: true,
		i1: true, i2: true, i3: true, i4: true, i5: true,
		contentpaddingaddition: true, rekeyaftertime: true, rekeytimeout: true,
		rejectaftertime: true, keepalivetimeout: true, maxhandshakeattempts: true,
		randomtrailers: true, disablecookies: true
	};
	const allowedPeer = {
		publickey: true, presharedkey: true, allowedips: true, endpoint: true,
		persistentkeepalive: true
	};
	for (let key in sections.interface)
		if (!allowedInterface[key]) return failure(`Unsupported Interface option ${key}`);
	for (let key in sections.peer)
		if (!allowedPeer[key]) return failure(`Unsupported Peer option ${key}`);

	const requiredInterface = [ 'privatekey', 'address' ];
	const requiredPeer = [ 'publickey', 'allowedips', 'endpoint' ];
	for (let key in requiredInterface)
		if (!sections.interface[key]) return failure(`Missing Interface option ${key}`);
	for (let key in requiredPeer)
		if (!sections.peer[key]) return failure(`Missing Peer option ${key}`);

	// Set defaults for optional parameters
	if (!sections.interface.mtu) sections.interface.mtu = '1420';

	for (let field in [ 'privatekey', 'publickey' ]) {
		const value = field == 'privatekey' ? sections.interface[field] : sections.peer[field];
		if (!match(value, /^[A-Za-z0-9+\/]{43}=$/))
			return failure(`Invalid ${field}`);
	}
	if (sections.peer.presharedkey && !match(sections.peer.presharedkey, /^[A-Za-z0-9+\/]{43}=$/))
		return failure('Invalid presharedkey');

	const addresses = parseList(sections.interface.address, 'Address', false);
	if (!addresses.ok) return addresses;
	const allowedIps = parseList(sections.peer.allowedips, 'AllowedIPs', true);
	if (!allowedIps.ok) return allowedIps;
	const endpoint = parseEndpoint(sections.peer.endpoint);
	if (!endpoint.ok) return endpoint;

	if (!match(sections.interface.mtu, /^[0-9]+$/) || +sections.interface.mtu < 576 || +sections.interface.mtu > 9000)
		return failure('MTU must be between 576 and 9000');
	for (let field in [ 's1', 's2', 's3', 's4', 'jc', 'jmin', 'jmax', 'h1', 'h2', 'h3', 'h4' ]) {
		if (sections.interface[field] != null) {
			if (!match(sections.interface[field], /^[0-9]+$/) || +sections.interface[field] > 4294967295)
				return failure(`Invalid numeric option ${field}`);
		}
	}
	if (sections.interface.jmin != null && sections.interface.jmax != null && +sections.interface.jmin > +sections.interface.jmax)
		return failure('Jmin must not be greater than Jmax');

	// AWG 3.0 range validation
	for (let field in [ 'contentpaddingaddition', 'rekeyaftertime', 'rekeytimeout', 'rejectaftertime', 'keepalivetimeout', 'maxhandshakeattempts' ]) {
		const val = sections.interface[field];
		if (val != null && !match(val, /^[0-9]+(-[0-9]+)?$/))
			return failure(`Invalid range option ${field} (expected NUMBER or MIN-MAX)`);
	}

	// AWG 3.1 boolean validation
	for (let field in [ 'randomtrailers', 'disablecookies' ]) {
		const val = sections.interface[field];
		if (val != null && !match(val, /^(on|off|true|false|yes|no|1|0)$/i))
			return failure(`Invalid boolean option ${field} (expected on/off)`);
	}

	if (sections.peer.persistentkeepalive && (!match(sections.peer.persistentkeepalive, /^[0-9]+$/) || +sections.peer.persistentkeepalive > 65535))
		return failure('Invalid PersistentKeepalive');

	const iFields = [];
	for (let field in [ 'i1', 'i2', 'i3', 'i4', 'i5' ]) {
		const value = sections.interface[field];
		if (value != null) {
			if (length(value) > 16384 || match(value, /[^\x20-\x7e]/))
				return failure(`${field} is too large or contains non-printable data`);
			push(iFields, { name: field, length: length(value) });
		}
	}

	let profile = replace(filename ?? 'Imported profile', /^.*[\\\/]/, '');
	profile = replace(profile, /[.]conf$/, '');
	profile = replace(profile, /[^A-Za-z0-9_.-]/g, '_');
	if (!length(profile)) profile = 'Imported_profile';
	profile = substr(profile, 0, 64);

	// Detect protocol variant
	let has_awg1 = (sections.interface.jc != null && +sections.interface.jc > 0) ||
	               (sections.interface.s1 != null && +sections.interface.s1 > 0) ||
	               (length(iFields) > 0);
	let has_awg3_0 = (sections.interface.contentpaddingaddition != null || sections.interface.rekeyaftertime != null);
	let has_awg3_1 = (sections.interface.randomtrailers != null || sections.interface.disablecookies != null);
	let variant = 'wireguard';
	if (has_awg3_0 && has_awg3_1) variant = 'awg3_hybrid';
	else if (has_awg3_1) variant = 'awg3_1';
	else if (has_awg3_0) variant = 'awg3_0';
	else if (has_awg1) variant = 'awg2';

	return {
		ok: true,
		profile,
		variant,
		interface: sections.interface,
		peer: sections.peer,
		addresses: addresses.values,
		allowed_ips: allowedIps.values,
		endpoint,
		i_fields: iFields,
	};
}

function restoreSection(uci, name, snapshot) {
	uci.delete('network', name);
	if (!snapshot) return;
	uci.set('network', name, snapshot['.type']);
	for (let key in snapshot)
		if (substr(key, 0, 1) != '.') uci.set('network', name, key, snapshot[key]);
}

function interfaceTopology(iface) {
	iface = validInterfaceName(iface) ?? targetInterface();
	const uci = cursor();
	uci.load('network');
	const interfaceSection = uci.get_all('network', iface);
	const peer = peerSectionFor(uci, iface);
	const has_interface = type(interfaceSection) == 'object' && interfaceSection['.type'] != null;
	const has_peer = peer != null;
	return {
		state: has_interface && has_peer ? 'present' : has_interface || has_peer ? 'partial' : 'missing',
		has_interface, has_peer
	};
}

function activateAwg(iface) {
	iface = validInterfaceName(iface) ?? targetInterface();
	const bus = connect();
	if (!bus) return false;

	bus.call('network', 'reload', {});
	command(`ifup ${shellquote(iface)} 2>/dev/null`);

	for (let attempt = 0; attempt < 15; attempt++) {
		const status = bus.call(`network.interface.${iface}`, 'status', {});
		if (status?.available == true && status?.up == true) return true;

		bus.call(`network.interface.${iface}`, 'up', {});
		command(`ifup ${shellquote(iface)} 2>/dev/null`);
		command('sleep 1');
	}

	const awgCheck = trim(command(`awg show ${shellquote(iface)} 2>/dev/null`));
	if (length(awgCheck)) return true;

	const devStatus = trim(command(`ip link show dev ${shellquote(iface)} 2>/dev/null`));
	if (length(devStatus) && index(devStatus, 'state UP') >= 0) return true;

	return false;
}

function runtimeHealthCheck(mode, iface) {
	iface = validInterfaceName(iface) ?? targetInterface();
	let timeout = 10;
	let resources = [ 'youtube.com' ];
	let attempts = 2;
	let resolvers = '77.88.8.8 77.88.8.1 1.1.1.1 8.8.8.8 9.9.9.9';
	mode = autoHealthMode(mode, 'strict');
	const uci = cursor();
	if (uci.load(AUTO_CONFIG)) {
		const main = uci.get_all(AUTO_CONFIG, AUTO_MAIN);
		if (main) {
			timeout = autoNumber(main.health_timeout, 10, 3, 30);
			attempts = 1 + autoNumber(main.health_retries, 1, 0, 4);
			const parsed = autoResources(main.critical_resource ?? [ 'youtube.com' ]);
			if (parsed) resources = parsed;
			resolvers = join(' ', autoResolvers(main.health_resolvers));
		}
	}
	/* netifd and the policy proxy may lag the interface by a few seconds. */
	let result = 'no health-check result';
	for (let attempt = 0; attempt < attempts; attempt++) {
		result = command(`sleep 2; /usr/libexec/awg-warp-auto/health-check.sh ${shellquote(iface)} ${timeout} ${shellquote(join(resources, ','))} ${mode} ${shellquote(resolvers)} 2>/dev/null`);
		if (match(result, /^OK [0-9]+$/))
			return { ok: true, detail: result };
	}
	return { ok: false, detail: length(result) ? result : 'no health-check result' };
}

function autoStageFile(path, filename) {
	if (type(path) != 'string' || !match(path, /^\/tmp\/awg-warp-auto\/generated\/[A-Za-z0-9_.-]+\.conf$/))
		return failure('Invalid generated candidate path');
	const text = command(`cat ${shellquote(path)} 2>/dev/null`);
	if (!length(text)) return failure('Generated candidate is missing');
	const parsed = parseAwgConfig(text, filename);
	if (!parsed.ok) {
		command(`rm -f ${shellquote(path)}`);
		return failure(`Generated candidate is invalid: ${parsed.error}`);
	}
	const digest = command(`sha256sum ${shellquote(path)} 2>/dev/null | awk '{print $1}'`);
	if (!match(digest, /^[0-9a-f]{64}$/i)) {
		command(`rm -f ${shellquote(path)}`);
		return failure('Unable to fingerprint generated candidate');
	}
	const id = `p_${substr(digest, 0, 24)}`;
	const uci = cursor();
	uci.load(AUTO_CONFIG);
	const existing = autoEntry(uci, id);
	if (existing) {
		command(`rm -f ${shellquote(path)}`);
		return {
			ok: true, id, existing: true, profile: existing.profile,
			endpoint: existing.endpoint, status: existing.status
		};
	}

	command(`mkdir -p ${shellquote(AUTO_POOL)} && chmod 700 '/etc/awg-warp-auto' ${shellquote(AUTO_POOL)}`);
	command(`cp ${shellquote(path)} ${shellquote(autoPath(id))} && chmod 600 ${shellquote(autoPath(id))}`);
	command(`rm -f ${shellquote(path)}`);
	const check = command(`test -s ${shellquote(autoPath(id))} && echo OK`);
	if (check != 'OK') return failure('Unable to protect generated candidate');

	const short_id = substr(digest, 0, 4);
	let prof_name = parsed.profile;
	if (prof_name == 'WARP_native_cloudflare' || prof_name == 'WARP_native' || !prof_name)
		prof_name = `WARP #${short_id}`;

	uci.set(AUTO_CONFIG, id, 'entry');
	uci.set(AUTO_CONFIG, id, 'fingerprint', digest);
	uci.set(AUTO_CONFIG, id, 'profile', prof_name);
	uci.set(AUTO_CONFIG, id, 'endpoint', `${parsed.endpoint.host}:${parsed.endpoint.port}`);
	uci.set(AUTO_CONFIG, id, 'status', 'NEW');
	uci.set(AUTO_CONFIG, id, 'created_at', command('date +%s'));
	uci.set(AUTO_CONFIG, id, 'failure_count', '0');
	if (!uci.commit(AUTO_CONFIG)) return failure('Unable to save candidate metadata');
	return { ok: true, id, profile: prof_name, endpoint: `${parsed.endpoint.host}:${parsed.endpoint.port}`, status: 'NEW' };
}

function autoHealth(timeout, resources, mode, measure_speed) {
	timeout = autoNumber(timeout, 10, 3, 30);
	resources = autoResources(resources);
	mode = autoHealthMode(mode, 'strict');
	const uci = cursor();
	let resolvers = '77.88.8.8 77.88.8.1 1.1.1.1 8.8.8.8 9.9.9.9';
	if (uci.load(AUTO_CONFIG)) {
		const main = uci.get_all(AUTO_CONFIG, AUTO_MAIN);
		if (main) {
			resolvers = join(' ', autoResolvers(main.health_resolvers));
			if (!resources) resources = autoResources(main.critical_resource);
		}
	}
	if (!resources) resources = [ 'youtube.com' ];
	const speed_flag = measure_speed ? '1' : '0';
	const result = command(`/usr/libexec/awg-warp-auto/health-check.sh ${shellquote(targetInterface())} ${timeout} ${shellquote(join(resources, ','))} ${mode} ${shellquote(resolvers)} ${speed_flag} 2>/dev/null`);
	const parts = split(trim(result), ' ');
	if (parts[0] != 'OK' || !parts[1]) return failure('Active YouTube health check failed');
	return { ok: true, latency_ms: +parts[1], speed_mbps: parts[2] ? +parts[2] : 0 };
}

function autoProbeCandidate(id, timeout) {
	const text = autoReadStored(id);
	if (!text) return failure('Candidate configuration is missing');
	const parsed = parseAwgConfig(text, `${id}.conf`);
	if (!parsed.ok) return failure('Candidate configuration is invalid');
	timeout = autoNumber(timeout, 10, 3, 30);
	const uci = cursor();
	let resolvers = '77.88.8.8 77.88.8.1 1.1.1.1 8.8.8.8 9.9.9.9';
	let is_active = false;
	if (uci.load(AUTO_CONFIG)) {
		const main = uci.get_all(AUTO_CONFIG, AUTO_MAIN);
		if (main) {
			resolvers = join(' ', autoResolvers(main.health_resolvers));
			if (main.active_id == id) is_active = true;
		}
	}
	if (is_active) {
		return autoHealth(timeout, [ 'youtube.com' ], 'strict', true);
	}
	const result = command(`/usr/libexec/awg-warp-auto/candidate-test.sh ${shellquote(autoPath(id))} ${timeout} 51822 ${shellquote(resolvers)} 2>/dev/null`);
	const parts = split(trim(result), ' ');
	if (parts[0] != 'OK' || !parts[1]) return failure('Candidate YouTube probe failed');
	return { ok: true, latency_ms: +parts[1], speed_mbps: parts[2] ? +parts[2] : 0 };
}

function autoStatus() {
	const uci = cursor();
	uci.load(AUTO_CONFIG);
	const main = uci.get_all(AUTO_CONFIG, AUTO_MAIN) ?? {};
	const target = targetInterface();
	const topology = interfaceTopology(target);
	const settings = {
		interface: target,
		enabled: autoBool(main.enabled),
		automatic_failover: autoBool(main.automatic_failover ?? '1'),
		failover_cooldown: autoNumber(main.failover_cooldown, 10, 5, 3600),
		provider: main.provider == 'native' ? 'native' : 'remote',
		awg_version: match(main.awg_version ?? '', /^(v2|v3_0|v3_1|v3_hybrid)$/) ? main.awg_version : 'v3_hybrid',
		source_url: main.source_url ?? 'https://warp-generation.github.io',
		native_sni: main.native_sni ?? '',
		native_quic_mode: main.native_quic_mode == 'fallback' ? 'fallback' : 'dynamic',
		native_endpoint_mode: main.native_endpoint_mode == 'custom' ? 'custom' : (main.native_endpoint_mode == 'auto_custom' ? 'auto_custom' : 'auto'),
		batch_size: autoNumber(main.batch_size ?? main.native_batch_limit, 5, 1, 10),
		native_batch_limit: autoNumber(main.batch_size ?? main.native_batch_limit, 5, 1, 10),
		native_min_interval: autoNumber(main.native_min_interval, 900, 60, 86400),
		native_endpoints: main.native_endpoint ?? [],
		refresh_interval: autoNumber(main.refresh_interval, 86400, 300, 604800),
		minimum_ready: autoNumber(main.minimum_ready, 2, 0, 10),
		health_interval: autoNumber(main.health_interval, 60, 5, 3600),
		health_timeout: autoNumber(main.health_timeout, 10, 3, 30),
		failure_threshold: autoNumber(main.failure_threshold, 3, 1, 10),
		health_mode: autoHealthMode(main.health_mode, topology.state == 'missing' ? 'direct' : 'strict'),
		log_level: autoLogLevel(main.log_level, 'info'),
		critical_resource: autoResources(main.critical_resource ?? [ 'youtube.com' ]) ?? [ 'youtube.com' ],
		health_resolvers: join(' ', autoResolvers(main.health_resolvers))
	};
	let current_operation = null;
	const op = readActiveOperation();
	if (op && (op.status == 'running' || (time() - autoNumber(op.updated_at, 0)) < 15)) {
		current_operation = op;
	}

	const pool = [];
	let active_health = '';
	let active_failures = 0;
	let active_last_health = 0;
	uci.foreach(AUTO_CONFIG, 'entry', (entry) => {
		const id = entry['.name'];
		if (!validAutoId(id)) return;
		const is_active = main.active_id == id;
		const failure_count = autoNumber(entry.failure_count, 0, 0, 999);
		if (is_active) {
			active_health = entry.health_state ?? (entry.last_health ? 'OK' : 'not checked');
			active_failures = failure_count;
			active_last_health = autoNumber(entry.last_health, 0, 0, 4294967295);
		}
		let pool_status = entry.status ?? 'NEW';
		if (current_operation && current_operation.status == 'running' && current_operation.candidate_id == id) {
			pool_status = 'ACTIVATING';
		}
		push(pool, {
			id, profile: entry.profile ?? id, endpoint: entry.endpoint ?? '',
			status: pool_status, created_at: autoNumber(entry.created_at, 0, 0, 4294967295),
			last_test: autoNumber(entry.last_test, 0, 0, 4294967295),
			last_health: autoNumber(entry.last_health, 0, 0, 4294967295),
			latency_ms: autoNumber(entry.latency_ms, 0, 0, 120000),
			speed_mbps: autoNumber(entry.speed_mbps, 0, 0, 100000),
			failure_count,
			blacklist_until: autoNumber(entry.blacklist_until, 0, 0, 4294967295),
			source_provider: entry.source_provider ?? 'unknown',
			endpoint_source: entry.endpoint_source ?? '',
			source_url: entry.source_url ?? '',
			last_error: entry.last_error ?? '',
			active: is_active
		});
	});
	const bus = connect();
	const iface = bus ? bus.call(`network.interface.${target}`, 'status', {}) : null;
	const daemon = command("ubus call service list '{\"name\":\"awg-warp-auto\"}' 2>/dev/null | grep -Eq '\"running\"[[:space:]]*:[[:space:]]*true' && echo running || echo stopped");

	/* Authoritative live peer state from AWG kernel interface */
	let actual_endpoint = '';
	let actual_public_key = '';
	let actual_handshake = 0;
	let actual_rx = 0;
	let actual_tx = 0;
	const dump_lines = split(command(`awg show ${shellquote(target)} dump 2>/dev/null`), '\n');
	if (length(dump_lines) > 1) {
		const peer_parts = split(dump_lines[1], '\t');
		if (length(peer_parts) >= 8) {
			actual_public_key = peer_parts[0] != '(none)' ? peer_parts[0] : '';
			actual_endpoint = peer_parts[2] != '(none)' ? peer_parts[2] : '';
			actual_handshake = autoNumber(peer_parts[4], 0, 0, 4294967295);
			actual_rx = autoNumber(peer_parts[5], 0, 0, 9223372036854775807);
			actual_tx = autoNumber(peer_parts[6], 0, 0, 9223372036854775807);
		}
	}
	const uci_peer_section = managedPeerSection(target);
	const uci_peer_desc = uci.get('network', uci_peer_section, 'description') ?? '';

	/* Read config file details for active or pool profiles without exposing secrets */
	const profile_configs = {};
	for (let entry in pool) {
		const conf_text = autoReadStored(entry.id);
		if (conf_text) {
			const parsed_c = parseAwgConfig(conf_text, `${entry.id}.conf`);
			if (parsed_c.ok) {
				const ifc = parsed_c.interface ?? {};
				entry.variant = parsed_c.variant ?? 'wireguard';
				profile_configs[entry.id] = {
					variant: parsed_c.variant ?? 'wireguard',
					mtu: ifc.mtu,
					jc: ifc.jc, jmin: ifc.jmin, jmax: ifc.jmax,
					s1: ifc.s1, s2: ifc.s2, s3: ifc.s3, s4: ifc.s4,
					h1: ifc.h1, h2: ifc.h2, h3: ifc.h3, h4: ifc.h4,
					contentpaddingaddition: ifc.contentpaddingaddition,
					rekeyaftertime: ifc.rekeyaftertime,
					rekeytimeout: ifc.rekeytimeout,
					rejectaftertime: ifc.rejectaftertime,
					keepalivetimeout: ifc.keepalivetimeout,
					maxhandshakeattempts: ifc.maxhandshakeattempts,
					randomtrailers: ifc.randomtrailers,
					disablecookies: ifc.disablecookies,
					i_fields: parsed_c.i_fields ?? []
				};
			} else {
				entry.variant = 'unknown';
			}
		} else {
			entry.variant = 'unknown';
		}
	}

	const runtime = {
		interface: target,
		available_interfaces: knownAwgInterfaces(),
		interface_state: topology.state,
		service: autoBool(main.enabled) ? daemon : 'disabled',
		available: iface?.available == true,
		up: iface?.up == true,
		active_id: main.active_id ?? '',
		previous_active_id: main.previous_active_id ?? '',
		health: active_health,
		last_health: active_last_health,
		consecutive_failures: active_failures,
		last_refresh: autoNumber(main.last_refresh, 0, 0, 4294967295),
		last_failover: autoNumber(main.last_failover, 0, 0, 4294967295),
		bootstrap_state: main.bootstrap_state ?? '',
		bootstrap_error: main.bootstrap_error ?? '',
		bootstrap_updated: autoNumber(main.bootstrap_updated, 0, 0, 4294967295),
		batch_state: main.batch_state ?? '',
		batch_message: main.batch_message ?? '',
		batch_provider: main.batch_provider ?? '',
		batch_requested: autoNumber(main.batch_requested, 0, 0, 100),
		batch_generated: autoNumber(main.batch_generated, 0, 0, 100),
		batch_ready: autoNumber(main.batch_ready, 0, 0, 100),
		batch_failed: autoNumber(main.batch_failed, 0, 0, 100),
		batch_updated: autoNumber(main.batch_updated, 0, 0, 4294967295),
		actual_endpoint,
		actual_public_key,
		actual_handshake,
		actual_rx,
		actual_tx,
		actual_peer_desc: uci_peer_desc
	};
	const raw_logs = command("logread -e awg-warp-auto 2>/dev/null | tail -n 50");
	return { ok: true, settings, runtime, pool, profile_configs, logs: length(raw_logs) ? split(raw_logs, '\n') : [], current_operation };
}

function saveAutoSettings(settings, defer_service) {
	if (type(settings) != 'object') return failure('Invalid WARP Auto settings');
	const source = autoSourceUrl(settings.source_url);
	const resources = autoResources(settings.critical_resource);
	const iface = validInterfaceName(settings.interface);
	if (!source) return failure('Source URL must be a safe absolute HTTPS URL');
	if (!resources) return failure('Critical resources must be host names');
	if (!iface) return failure('Interface name must use letters, digits, or underscores and be at most 15 characters');
	const values = {
		interface: iface,
		enabled: autoBool(settings.enabled) ? '1' : '0',
		automatic_failover: autoBool(settings.automatic_failover) ? '1' : '0',
		failover_cooldown: '' + autoNumber(settings.failover_cooldown, 10, 5, 3600),
		provider: settings.provider == 'native' ? 'native' : 'remote',
		awg_version: match(settings.awg_version ?? '', /^(v2|v3_0|v3_1|v3_hybrid)$/) ? settings.awg_version : 'v3_hybrid',
		source_url: source,
		native_sni: match(settings.native_sni ?? '', /^[A-Za-z0-9.-]{0,253}$/) ? (settings.native_sni ?? '') : '',
		native_quic_mode: settings.native_quic_mode == 'fallback' ? 'fallback' : 'dynamic',
		native_endpoint_mode: settings.native_endpoint_mode == 'custom' ? 'custom' : (settings.native_endpoint_mode == 'auto_custom' ? 'auto_custom' : 'auto'),
		batch_size: '' + autoNumber(settings.batch_size ?? settings.native_batch_limit, 5, 1, 10),
		native_batch_limit: '' + autoNumber(settings.batch_size ?? settings.native_batch_limit, 5, 1, 10),
		native_min_interval: '' + autoNumber(settings.native_min_interval, 900, 60, 86400),
		refresh_interval: '' + autoNumber(settings.refresh_interval, 86400, 300, 604800),
		minimum_ready: '' + autoNumber(settings.minimum_ready, 2, 0, 10),
		health_interval: '' + autoNumber(settings.health_interval, 60, 5, 3600),
		health_timeout: '' + autoNumber(settings.health_timeout, 10, 3, 30),
		failure_threshold: '' + autoNumber(settings.failure_threshold, 3, 1, 10),
		health_mode: autoHealthMode(settings.health_mode, 'strict'),
		log_level: autoLogLevel(settings.log_level, 'info'),
		health_resolvers: join(' ', autoResolvers(settings.health_resolvers))
	};
	const uci = cursor();
	uci.load(AUTO_CONFIG);
	uci.set(AUTO_CONFIG, AUTO_MAIN, 'awg_warp_auto');
	for (let name in values) uci.set(AUTO_CONFIG, AUTO_MAIN, name, values[name]);
	uci.set(AUTO_CONFIG, AUTO_MAIN, 'critical_resource', resources);
	const submitted_endpoints = settings.native_endpoints ?? settings.native_endpoint;
	uci.delete(AUTO_CONFIG, AUTO_MAIN, 'native_endpoint');
	if (type(submitted_endpoints) == 'array') {
		const endpoints = filter(submitted_endpoints, (v) => type(v) == 'string' && match(v, /^[A-Za-z0-9.-]+:[0-9]{1,5}$/));
		if (length(endpoints)) uci.set(AUTO_CONFIG, AUTO_MAIN, 'native_endpoint', endpoints);
	}
	if (!uci.commit(AUTO_CONFIG)) return failure('Unable to save WARP Auto settings');
	if (defer_service) return autoStatus();
	if (values.enabled == '1')
		command('/etc/init.d/awg-warp-auto enable; /etc/init.d/awg-warp-auto restart');
	else
		command('/etc/init.d/awg-warp-auto stop; /etc/init.d/awg-warp-auto disable');
	return autoStatus();
}

function applyParsedConfig(parsed, health_mode, iface, validate_youtube) {
	health_mode = autoHealthMode(health_mode, 'strict');
	iface = validInterfaceName(iface) ?? targetInterface();
	const is_warp_target = (iface == targetInterface());
	const do_yt_check = (validate_youtube == true) || (validate_youtube == null && is_warp_target);

	const uci = cursor();
	uci.load('network');
	const peerSection = peerSectionFor(uci, iface);
	const managedPeer = managedPeerSection(iface);
	const oldInterface = uci.get_all('network', iface);
	const oldPeer = peerSection ? uci.get_all('network', peerSection) : null;

	uci.delete('network', iface);
	if (peerSection) uci.delete('network', peerSection);
	if (managedPeer != peerSection) uci.delete('network', managedPeer);
	uci.set('network', iface, 'interface');
	uci.set('network', iface, 'proto', 'amneziawg');
	uci.set('network', iface, 'auto', '1');
	uci.set('network', iface, 'nohostroute', '1');
	uci.set('network', iface, 'defaultroute', '0');
	uci.set('network', iface, 'peerdns', '0');
	uci.set('network', iface, 'private_key', parsed.interface.privatekey);
	uci.set('network', iface, 'listen_port', parsed.interface.listenport || (oldInterface?.listen_port ?? '51821'));
	/* 0x08000000 belongs to the existing Forkop/YT policy rule. Reusing it
	 * marks AWG's outer UDP and routes it back into the same tunnel. */
	if (is_warp_target)
		uci.set('network', iface, 'fwmark', '0x01000000');
	uci.set('network', iface, 'mtu', parsed.interface.mtu || '1420');
	uci.set('network', iface, 'addresses', parsed.addresses);

	for (let field in [ 'jc', 'jmin', 'jmax', 's1', 's2', 's3', 's4', 'h1', 'h2', 'h3', 'h4', 'i1', 'i2', 'i3', 'i4', 'i5',
	                    'contentpaddingaddition', 'rekeyaftertime', 'rekeytimeout', 'rejectaftertime', 'keepalivetimeout', 'maxhandshakeattempts',
	                    'randomtrailers', 'disablecookies' ]) {
		if (parsed.interface[field] != null) uci.set('network', iface, `awg_${field}`, parsed.interface[field]);
	}

	uci.set('network', managedPeer, `amneziawg_${iface}`);
	uci.set('network', managedPeer, 'description', parsed.profile);
	uci.set('network', managedPeer, 'public_key', parsed.peer.publickey);
	uci.set('network', managedPeer, 'route_allowed_ips', '0');
	uci.set('network', managedPeer, 'endpoint_host', parsed.endpoint.host);
	uci.set('network', managedPeer, 'endpoint_port', parsed.endpoint.port);
	uci.set('network', managedPeer, 'allowed_ips', parsed.allowed_ips);
	if (parsed.peer.presharedkey) uci.set('network', managedPeer, 'preshared_key', parsed.peer.presharedkey);
	if (parsed.peer.persistentkeepalive) uci.set('network', managedPeer, 'persistent_keepalive', parsed.peer.persistentkeepalive);

	if (is_warp_target) {
		const egressName = `${lc(iface)}_ipv4_egress`;
		const markName = `${lc(iface)}_ipv4_mark`;
		if (!uci.get('network', egressName)) {
			uci.set('network', egressName, 'route');
			uci.set('network', egressName, 'interface', iface);
			uci.set('network', egressName, 'target', '0.0.0.0/0');
			uci.set('network', egressName, 'table', '101');
		}
		if (!uci.get('network', markName)) {
			uci.set('network', markName, 'rule');
			uci.set('network', markName, 'priority', '104');
			uci.set('network', markName, 'mark', '0x08000000/0x08000000');
			uci.set('network', markName, 'lookup', '101');
		}
	}

	if (!uci.commit('network')) {
		restoreSection(uci, iface, oldInterface);
		restoreSection(uci, managedPeer, oldPeer);
		uci.commit('network');
		return failure('Unable to commit network configuration');
	}

	const activated = activateAwg(iface);
	if (!do_yt_check) {
		return { ok: true, profile: parsed.profile, endpoint: `${parsed.endpoint.host}:${parsed.endpoint.port}`, interface: iface, variant: parsed.variant };
	}

	const health = activated ? runtimeHealthCheck(health_mode, iface) : { ok: false, detail: 'interface did not become available' };
	if (activated && health.ok)
		return { ok: true, profile: parsed.profile, endpoint: `${parsed.endpoint.host}:${parsed.endpoint.port}`, interface: iface, variant: parsed.variant };

	const rollback = cursor();
	rollback.load('network');
	restoreSection(rollback, iface, oldInterface);
	restoreSection(rollback, managedPeer, oldPeer);
	rollback.commit('network');
	activateAwg(iface);
	return failure(`Health check failed (${health.detail}); the previous profile was restored`);
}

const methods = {
	getWarpAutoStatus: {
		call: function() {
			return autoStatus();
		}
	},

	saveWarpAutoSettings: {
		args: { settings: {}, defer_service: 'defer_service' },
		call: function(req) {
			if (auto_busy) return failure('Another WARP Auto operation is already running');
			auto_busy = true;
			const result = saveAutoSettings(req.args?.settings, autoBool(req.args?.defer_service));
			auto_busy = false;
			return result;
		}
	},

	warpAutoAction: {
		args: { action: 'action', id: 'id' },
		call: function(req) {
			if (auto_busy) return failure('Another WARP Auto operation is already running');
			const action = req.args?.action;
			const id = req.args?.id;
			let command_line = null;
			if (action == 'refresh') command_line = '/usr/libexec/awg-warp-auto/daemon.sh refresh';
			else if (action == 'batch' || action == 'generate_batch') {
				const batch_cnt = (id && match(id, /^[0-9]+$/)) ? id : '';
				command_line = batch_cnt ? `/usr/libexec/awg-warp-auto/daemon.sh batch ${batch_cnt}` : '/usr/libexec/awg-warp-auto/daemon.sh batch';
			}
			else if (action == 'test_all') command_line = '/usr/libexec/awg-warp-auto/daemon.sh test_all';
			else if (action == 'rollback') command_line = '/usr/libexec/awg-warp-auto/daemon.sh rollback';
			else if (action == 'native_test') command_line = '/usr/libexec/awg-warp-auto/daemon.sh batch 1';
			else if (action == 'force_replenish') command_line = '/usr/libexec/awg-warp-auto/daemon.sh force_replenish';
			else if (action == 'clean_replenish') {
				const replenish_cnt = (id && match(id, /^[0-9]+$/)) ? id : '';
				command_line = replenish_cnt ? `/usr/libexec/awg-warp-auto/daemon.sh clean_replenish ${replenish_cnt}` : '/usr/libexec/awg-warp-auto/daemon.sh clean_replenish';
			}
			else if (action == 'retest' && validAutoId(id)) command_line = `/usr/libexec/awg-warp-auto/daemon.sh retest ${id}`;
			else if (action == 'delete' && validAutoId(id)) {
				const active = cursor().get(AUTO_CONFIG, AUTO_MAIN, 'active_id');
				if (id == active) return failure('Cannot delete active profile');
				auto_busy = true;
				command(`/usr/libexec/awg-warp-auto/daemon.sh delete ${shellquote(id)}`);
				auto_busy = false;
				return { ok: true, action: 'delete', id: id };
			}
			else if (action == 'bootstrap') {
				const status = cursor();
				status.load(AUTO_CONFIG);
				if (status.get(AUTO_CONFIG, AUTO_MAIN, 'bootstrap_state') == 'running')
					return failure('Initial WARP setup is already running');
				/* A requested bootstrap owns the first activation. Stop any pre-enabled
				 * daemon before it can race this foreground setup job. */
				command('/etc/init.d/awg-warp-auto stop >/dev/null 2>&1');
				command_line = '/usr/libexec/awg-warp-auto/daemon.sh bootstrap';
			}
			else if (action == 'activate' && validAutoId(id)) {
				const existing_op = readActiveOperation();
				if (existing_op && existing_op.status == 'running')
					return failure('Another activation is already in progress', 'operation_in_progress');

				const op_id = sprintf('op_act_%d', time());
				command('mkdir -p /tmp/awg-warp-auto');
				const init_op = {
					operation_id: op_id,
					action: 'activate',
					candidate_id: id,
					status: 'running',
					step: 'applying',
					started_at: time(),
					updated_at: time(),
					error: null
				};
				writefile('/tmp/awg-warp-auto/operation.json', sprintf('%J\n', init_op));
				const configured_health = cursor().get(AUTO_CONFIG, AUTO_MAIN, 'health_mode');
				const mode = autoHealthMode(configured_health, 'direct');
				command(`/usr/libexec/awg-warp-auto/activate-worker.uc ${shellquote(id)} ${shellquote(mode)} ${shellquote(op_id)} >/dev/null 2>&1 &`);
				return { ok: true, started: true, action: 'activate', operation_id: op_id, id: id };
			}
			else return failure('Invalid WARP Auto action');
			auto_busy = true;
			command(`${command_line} >/dev/null 2>&1 &`);
			auto_busy = false;
			return { ok: true, started: true, action, id: validAutoId(id) ? id : null };
		}
	},

	getWarpAutoOperation: {
		args: { operation_id: 'operation_id' },
		call: function(req) {
			const op = readActiveOperation();
			return { ok: true, operation: op };
		}
	},

	stageWarpAutoFile: {
		args: { path: 'path', filename: 'filename' },
		call: function(req) {
			if (auto_busy) return failure('Another WARP Auto operation is already running');
			auto_busy = true;
			const result = autoStageFile(req.args?.path, req.args?.filename);
			auto_busy = false;
			return result;
		}
	},

	testWarpAutoCandidate: {
		args: { id: 'id', timeout: 'timeout' },
		call: function(req) {
			return autoProbeCandidate(req.args?.id, req.args?.timeout);
		}
	},

	activateWarpAutoCandidate: {
		args: { id: 'id', health_mode: 'health_mode' },
		call: function(req) {
			const id = req.args?.id;
			if (!validAutoId(id)) return failure('Invalid candidate id');
			const health_mode = autoHealthMode(req.args?.health_mode, 'strict');
			const res = command(`/usr/libexec/awg-warp-auto/activate-worker.uc ${shellquote(id)} ${shellquote(health_mode)} 2>/dev/null`);
			let parsed = null;
			try { parsed = json(res); } catch(e) {}
			return parsed ?? failure('Activation worker failed');
		}
	},

	getWarpAutoHealth: {
		args: { timeout: 'timeout', resources: 'resources', mode: 'mode', measure_speed: 'measure_speed' },
		call: function(req) {
			return autoHealth(req.args?.timeout, req.args?.resources, req.args?.mode, req.args?.measure_speed);
		}
	},

	getWarpAutoRankedSubnets: {
		args: {},
		call: function(req) {
			let path = '/tmp/awg-warp-auto/ranked_subnets.json';
			if (!stat(path)) {
				command('/usr/libexec/awg-warp-auto/endpoint-rank.sh >/dev/null 2>&1');
			}
			let content = readfile(path);
			if (!content) return { ok: false, subnets: [] };
			let parsed = null;
			try { parsed = json(content); } catch(e) {}
			return { ok: true, subnets: parsed ?? [] };
		}
	},

	validateAwgConfig: {
		args: { config: 'config', filename: 'filename' },
		call: function(req) {
			const parsed = parseAwgConfig(req.args?.config, req.args?.filename);
			if (!parsed.ok) return parsed;
			return {
				ok: true,
				profile: parsed.profile,
				variant: parsed.variant,
				addresses: parsed.addresses,
				endpoint: `${parsed.endpoint.host}:${parsed.endpoint.port}`,
				i_fields: parsed.i_fields,
				warnings: parsed.warnings
			};
		}
	},

	importAwgConfig: {
		args: { config: 'config', filename: 'filename', interface: 'interface', validate_youtube: 'validate_youtube' },
		call: function(req) {
			if (import_busy || autoOperationLocked()) return failure('WARP Auto is busy; wait for its current action to finish');
			import_busy = true;
			const parsed = parseAwgConfig(req.args?.config, req.args?.filename);
			if (!parsed.ok) {
				import_busy = false;
				return parsed;
			}
			const iface = validInterfaceName(req.args?.interface) ?? targetInterface();
			const val_yt = autoBool(req.args?.validate_youtube);
			const result = applyParsedConfig(parsed, 'strict', iface, val_yt);
			import_busy = false;
			return result;
		}
	},

	createInterface: {
		args: { name: 'name', zone: 'zone', config: 'config', filename: 'filename' },
		call: function(req) {
			const name = validInterfaceName(req.args?.name);
			if (!name) return failure('Invalid interface name (1-15 characters, letters, numbers and underscore, starts with letter)');
			const uci = cursor();
			uci.load('network');
			if (uci.get('network', name)) return failure(`Interface "${name}" already exists`);

			const zone = req.args?.zone || 'wan';
			uci.set('network', name, 'interface');
			uci.set('network', name, 'proto', 'amneziawg');
			uci.set('network', name, 'defaultroute', '0');
			uci.set('network', name, 'peerdns', '0');
			uci.set('network', name, 'listen_port', '' + (51820 + (time() % 1000)));

			if (!uci.commit('network')) return failure('Failed to save network configuration');

			// Add to firewall zone if requested
			if (zone == 'wan' || zone == 'vpn') {
				uci.load('firewall');
				let target_zone = null;
				uci.foreach('firewall', 'zone', (z) => {
					if (z.name == zone) target_zone = z['.name'];
				});
				if (target_zone) {
					let nets = uci.get('firewall', target_zone, 'network') || [];
					if (type(nets) == 'string') nets = [ nets ];
					let has = false;
					for (let n in nets) if (n == name) has = true;
					if (!has) {
						push(nets, name);
						uci.set('firewall', target_zone, 'network', nets);
						uci.commit('firewall');
						command('/etc/init.d/firewall reload 2>/dev/null &');
					}
				}
			}

			// If config provided, apply it immediately
			if (req.args?.config) {
				const parsed = parseAwgConfig(req.args.config, req.args?.filename);
				if (!parsed.ok) return parsed;
				return applyParsedConfig(parsed, 'direct', name, false);
			}

			// Otherwise generate a default private key
			const priv = trim(command('awg genkey 2>/dev/null') || '');
			if (length(priv)) {
				uci.load('network');
				uci.set('network', name, 'private_key', priv);
				uci.commit('network');
			}
			command(`/sbin/ifup ${shellquote(name)} 2>/dev/null &`);
			return { ok: true, interface: name };
		}
	},

	deleteInterface: {
		args: { name: 'name' },
		call: function(req) {
			const name = validInterfaceName(req.args?.name);
			if (!name) return failure('Invalid interface name');
			const uci = cursor();
			uci.load('network');
			if (!uci.get('network', name)) return failure(`Interface "${name}" does not exist`);
			if (uci.get('network', name, 'proto') != 'amneziawg')
				return failure(`Interface "${name}" is not an AmneziaWG interface`);

			// Bring down interface
			command(`/sbin/ifdown ${shellquote(name)} 2>/dev/null`);

			// Delete interface and peer sections
			const peerSection = peerSectionFor(uci, name);
			const managedPeer = managedPeerSection(name);
			uci.delete('network', name);
			if (peerSection) uci.delete('network', peerSection);
			if (managedPeer != peerSection) uci.delete('network', managedPeer);

			uci.delete('network', `${lc(name)}_ipv4_egress`);
			uci.delete('network', `${lc(name)}_ipv4_mark`);
			uci.commit('network');

			// Clean from firewall
			uci.load('firewall');
			uci.foreach('firewall', 'zone', (z) => {
				let nets = z.network || [];
				if (type(nets) == 'string') nets = [ nets ];
				let filtered = [];
				let changed = false;
				for (let n in nets) {
					if (n == name) changed = true;
					else push(filtered, n);
				}
				if (changed) {
					uci.set('firewall', z['.name'], 'network', filtered);
				}
			});
			uci.commit('firewall');
			command('/etc/init.d/firewall reload 2>/dev/null &');

			return { ok: true, deleted: name };
		}
	},

	restartInterface: {
		args: { name: 'name' },
		call: function(req) {
			const name = validInterfaceName(req.args?.name);
			if (!name) return failure('Invalid interface name');
			command(`/sbin/ifdown ${shellquote(name)} 2>/dev/null; sleep 1; /sbin/ifup ${shellquote(name)} 2>/dev/null &`);
			return { ok: true, restarted: name };
		}
	},

	exportInterfaceConfig: {
		args: { name: 'name' },
		call: function(req) {
			const name = validInterfaceName(req.args?.name);
			if (!name) return failure('Invalid interface name');
			const uci = cursor();
			uci.load('network');
			const ifsec = uci.get_all('network', name);
			if (!ifsec || ifsec.proto != 'amneziawg') return failure(`AmneziaWG interface "${name}" not found`);

			let peer = null;
			uci.foreach('network', `amneziawg_${name}`, (p) => { if (!peer) peer = p; });
			if (!peer) {
				const mp = managedPeerSection(name);
				peer = uci.get_all('network', mp);
			}

			let conf = '[Interface]\n';
			if (ifsec.private_key) conf += `PrivateKey = ${ifsec.private_key}\n`;
			if (ifsec.addresses) {
				let addrs = ifsec.addresses;
				if (type(addrs) == 'array') addrs = join(', ', addrs);
				conf += `Address = ${addrs}\n`;
			}
			if (ifsec.mtu) conf += `MTU = ${ifsec.mtu}\n`;
			if (ifsec.listen_port) conf += `ListenPort = ${ifsec.listen_port}\n`;

			const hpk = ifsec.awg_header_protection_key || ifsec.awg_headerprotectionkey;
			if (hpk) conf += `HeaderProtectionKey = ${hpk}\n`;

			for (let f in [ 'jc', 'jmin', 'jmax', 's1', 's2', 's3', 's4', 'h1', 'h2', 'h3', 'h4', 'i1', 'i2', 'i3', 'i4', 'i5' ]) {
				const val = ifsec[`awg_${f}`];
				if (val != null) conf += `${uc(substr(f,0,1)) + substr(f,1)} = ${val}\n`;
			}
			const rangeNames = {
				contentpaddingaddition: 'ContentPaddingAddition',
				rekeyaftertime: 'RekeyAfterTime',
				rekeytimeout: 'RekeyTimeout',
				rejectaftertime: 'RejectAfterTime',
				keepalivetimeout: 'KeepaliveTimeout',
				maxhandshakeattempts: 'MaxHandshakeAttempts'
			};
			for (let f in [ 'contentpaddingaddition', 'rekeyaftertime', 'rekeytimeout', 'rejectaftertime', 'keepalivetimeout', 'maxhandshakeattempts' ]) {
				const val = ifsec[`awg_${f}`] ?? ifsec[`awg_${f}`];
				if (val != null) conf += `${rangeNames[f]} = ${val}\n`;
			}
			const boolNames = { randomtrailers: 'RandomTrailers', disablecookies: 'DisableCookies' };
			for (let f in [ 'randomtrailers', 'disablecookies' ]) {
				const val = ifsec[`awg_${f}`];
				if (val != null && val != '0' && val != '') conf += `${boolNames[f]} = 1\n`;
			}

			if (peer && peer.public_key) {
				conf += '\n[Peer]\n';
				conf += `PublicKey = ${peer.public_key}\n`;
				if (peer.preshared_key) conf += `PresharedKey = ${peer.preshared_key}\n`;
				if (peer.allowed_ips) {
					let aips = peer.allowed_ips;
					if (type(aips) == 'array') aips = join(', ', aips);
					conf += `AllowedIPs = ${aips}\n`;
				}
				if (peer.endpoint_host) {
					const port = peer.endpoint_port || '51820';
					conf += `Endpoint = ${peer.endpoint_host}:${port}\n`;
				}
				if (peer.persistent_keepalive) conf += `PersistentKeepalive = ${peer.persistent_keepalive}\n`;
			}

			return { ok: true, filename: `${name}.conf`, config: conf };
		}
	},

	generatePsk: {
		call: function() {
			return { psk: command('awg genpsk 2>/dev/null') };
		}
	},

	generateKeyPair: {
		call: function() {
			const priv = command('awg genkey 2>/dev/null');
			const pub = command(`echo ${shellquote(priv)} | awg pubkey 2>/dev/null`);

			return { keys: { priv, pub } };
		}
	},

	getPublicAndPrivateKeyFromPrivate: {
		args: { privkey: "privkey" },
		call: function(req) {
			const priv = req.args?.privkey;
			const pub = command(`echo ${shellquote(priv)} | awg pubkey 2>/dev/null`);

			return { keys: { priv, pub } };
		}
	},

	getAwgInstances: {
		call: function() {
			const data = {};
			const uci = cursor();
			uci.load('network');

			const uci_fw = cursor();
			uci_fw.load('firewall');
			const iface_zones = {};
			uci_fw.foreach('firewall', 'zone', (z) => {
				let nets = z.network || [];
				if (type(nets) == 'string') nets = split(nets, /\s+/);
				for (let net in nets) {
					if (net) iface_zones[net] = z.name;
				}
			});

			// 1. Discover all configured AmneziaWG interfaces from UCI
			uci.foreach('network', 'interface', (entry) => {
				const name = validInterfaceName(entry['.name']);
				if (name && entry.proto == 'amneziawg') {
					let addrs = entry.addresses || [];
					if (type(addrs) == 'string') addrs = [ addrs ];

					let has_awg1 = (entry.awg_jc != null && +entry.awg_jc > 0) ||
					               (entry.awg_s1 != null && +entry.awg_s1 > 0) ||
					               (entry.awg_i1 != null);
					let has_awg3_0 = (entry.awg_contentpaddingaddition != null || entry.awg_rekeyaftertime != null);
					let has_awg3_1 = (entry.awg_randomtrailers != null || entry.awg_disablecookies != null);
					let variant = 'wireguard';
					if (has_awg3_0 && has_awg3_1) variant = 'awg3_hybrid';
					else if (has_awg3_1) variant = 'awg3_1';
					else if (has_awg3_0) variant = 'awg3_0';
					else if (has_awg1) variant = 'awg2';

					let peers = [];
					let peerSec = peerSectionFor(uci, name);
					if (!peerSec) peerSec = managedPeerSection(name);
					const p = peerSec ? uci.get_all('network', peerSec) : null;
					if (p && p.public_key) {
						let aips = p.allowed_ips || [];
						if (type(aips) == 'string') aips = [ aips ];
						push(peers, {
							name: p.description || '',
							public_key: p.public_key,
							endpoint: p.endpoint_host ? `${p.endpoint_host}:${p.endpoint_port || 51820}` : '(none)',
							allowed_ips: aips,
							latest_handshake: 0,
							transfer_rx: 0,
							transfer_tx: 0,
							persistent_keepalive: p.persistent_keepalive || 0
						});
					}

					data[name] = {
						name: name,
						public_key: '',
						listen_port: entry.listen_port || '51820',
						fwmark: entry.fwmark || '',
						addresses: addrs,
						mtu: entry.mtu || '1420',
						variant: variant,
						zone: iface_zones[name] || '',
						status: 'down',
						peers: peers
					};
				}
			});

			// 2. Overlay live kernel status from `awg show all dump`
			const wg_dump = popen("awg show all dump 2>/dev/null");
			if (wg_dump) {
				let cur_dev = null;
				for (let line = wg_dump.read('line'); length(line); line = wg_dump.read('line')) {
					const record = split(rtrim(line, '\n'), '\t');
					if (cur_dev != record[0]) {
						cur_dev = record[0];
						if (!data[cur_dev]) {
							data[cur_dev] = { name: cur_dev, variant: 'amneziawg', peers: [], addresses: [] };
						}
						data[cur_dev].public_key = record[2];
						data[cur_dev].listen_port = record[3];
						data[cur_dev].fwmark = record[4];
						data[cur_dev].status = 'up';
						data[cur_dev].peers = [];
					} else {
						let peer_name;
						uci.foreach('network', `amneziawg_${cur_dev}`, (s) => {
							if (!s.disabled && s.public_key == record[1]) peer_name = s.description;
						});
						const peer = {
							name: peer_name,
							public_key: record[1],
							endpoint: record[3],
							allowed_ips: [],
							latest_handshake: record[5],
							transfer_rx: record[6],
							transfer_tx: record[7],
							persistent_keepalive: record[8]
						};
						if (record[3] != '(none)' && length(record[4]))
							push(peer.allowed_ips, ...split(record[4], ','));
						push(data[cur_dev].peers, peer);
					}
				}
			}

			return data;
		}
	},

	getForkopStatus: {
		call: function() {
			const installed = (stat('/etc/config/forkop') != null && stat('/etc/init.d/forkop') != null);
			if (!installed) {
				return { installed: false };
			}
			const uci = cursor();
			uci.load('awg-warp-auto');
			const managed_sec = uci.get('awg-warp-auto', 'main', 'forkop_section');
			const iface = uci.get('awg-warp-auto', 'main', 'interface') || 'YTwarp';

			uci.load('forkop');
			let sec_info = null;
			if (managed_sec) {
				const s = uci.get_all('forkop', managed_sec);
				if (s) {
					sec_info = {
						name: managed_sec,
						enabled: s.enabled == '1',
						action: s.action || 'connection'
					};
				}
			}

			return {
				installed: true,
				managed_section: managed_sec,
				section_info: sec_info,
				target_interface: iface
			};
		}
	},

	configureForkopSection: {
		args: { iface: "iface" },
		call: function(req) {
			if (!(stat('/etc/config/forkop') != null && stat('/etc/init.d/forkop') != null))
				return failure("Forkop is not installed on this router");

			const uci = cursor();
			uci.load('awg-warp-auto');
			const target_iface = validInterfaceName(req.args?.iface) || uci.get('awg-warp-auto', 'main', 'interface') || 'YTwarp';

			uci.load('forkop');
			let sec_name = uci.get('awg-warp-auto', 'main', 'forkop_section');
			if (!sec_name || !uci.get('forkop', sec_name)) {
				if (!uci.get('forkop', 'YT')) {
					sec_name = 'YT';
				} else {
					for (let i = 2; i < 100; i++) {
						const candidate = `YT${i}`;
						if (!uci.get('forkop', candidate)) {
							sec_name = candidate;
							break;
						}
					}
					if (!sec_name) sec_name = `YT_${time()}`;
				}
			}

			const domains = [
				'youtube.com',
				'googlevideo.com',
				'ytimg.com',
				'youtube-nocookie.com',
				'youtu.be',
				'googleusercontent.com',
				'ggpht.com',
				'netlify.app',
				'googleadservices.com',
				'doubleclick.net',
				'firebaseio.com',
				'smarttube-tv.firebaseio.com',
				'smarttube-tv.firebasestorage.app',
				'sponsor.ajay.app',
				'sponsorblock.org',
				'dearrow.ajay.app',
				'returnyoutubedislikeapi.com',
				'api.github.com',
				'raw.githubusercontent.com',
				'objects.githubusercontent.com',
				'yting.com',
				'youtubekids.com',
				'yt.be',
				'wide-youtube.l.google.com',
				'ytimg.l.google.com',
				'youtubei.googleapis.com',
				'youtube.googleapis.com',
				'youtubeembeddedplayer.googleapis.com',
				'youtube-ui.l.google.com',
				'yt-video-upload.l.google.com',
				'jnn-pa.googleapis.com',
				'yt3.googleusercontent.com',
				'yt.ggpht.com',
				'yt3.ggpht.com',
				'yt4.ggpht.com',
				'img.youtube.com',
				'i.ytimg.com',
				'i1.ytimg.com',
				'i2.ytimg.com',
				'i3.ytimg.com',
				'i4.ytimg.com',
				'i5.ytimg.com',
				'i6.ytimg.com',
				'i7.ytimg.com',
				'i8.ytimg.com',
				'i9.ytimg.com',
				's.ytimg.com',
				'manifest.googlevideo.com',
				'gstatic.com',
				'googleapis.com',
				'l.google.com',
				'1e100.net',
				'gvt1.com',
				'gvt2.com',
				'gvt3.com',
				'gvt4.com',
				'play.google.com',
				'play.googleapis.com',
				'play-fe.googleapis.com',
				'android.clients.google.com',
				'play-lh.googleusercontent.com',
				'nhacmp3youtube.com',
				'withyoutube.com',
				'm.youtube.com',
				'music.youtube.com',
				'studio.youtube.com',
				'tv.youtube.com',
				'kids.youtube.com',
				's.youtube.com',
				'cdn.youtube.com',
				'signaler-pa.youtube.com',
				'speed.cloudflare.com',
				'2ip.io'
			];

			uci.set('forkop', sec_name, 'section');
			uci.set('forkop', sec_name, 'enabled', '1');
			uci.set('forkop', sec_name, 'action', 'connection');
			uci.set('forkop', sec_name, 'sort_by_latency', '1');
			uci.set('forkop', sec_name, 'outbound_detour_enabled', '0');
			uci.set('forkop', sec_name, 'mixed_proxy_enabled', '0');
			uci.set('forkop', sec_name, 'resolve_real_ip_for_routing', '0');
			uci.set('forkop', sec_name, 'dashboard_filter_mode', 'disabled');
			uci.set('forkop', sec_name, 'domain', join('\n', domains));

			uci.foreach('forkop', 'section_interface', (s) => {
				if (s.section == sec_name) uci.delete('forkop', s['.name']);
			});

			const sif = uci.add('forkop', 'section_interface');
			uci.set('forkop', sif, 'section', sec_name);
			uci.set('forkop', sif, 'name', target_iface);
			uci.set('forkop', sif, 'domain_resolver_enabled', '0');
			uci.set('forkop', sif, 'domain_resolver_dns_type', 'udp');
			uci.set('forkop', sif, 'domain_resolver_dns_server', '8.8.8.8');
			uci.commit('forkop');

			uci.set('awg-warp-auto', 'main', 'forkop_section', sec_name);
			uci.commit('awg-warp-auto');

			command('/etc/init.d/forkop reload 2>/dev/null &');

			return { ok: true, section: sec_name, interface: target_iface };
		}
	},

	removeForkopSection: {
		args: { section: "section" },
		call: function(req) {
			if (!(stat('/etc/config/forkop') != null && stat('/etc/init.d/forkop') != null))
				return { ok: true, removed: null };

			const uci = cursor();
			uci.load('awg-warp-auto');
			const sec = req.args?.section || uci.get('awg-warp-auto', 'main', 'forkop_section');
			if (!sec) return { ok: true, removed: null };

			uci.load('forkop');
			if (uci.get('forkop', sec)) {
				uci.delete('forkop', sec);
			}
			uci.foreach('forkop', 'section_interface', (s) => {
				if (s.section == sec) uci.delete('forkop', s['.name']);
			});
			uci.commit('forkop');

			uci.delete('awg-warp-auto', 'main', 'forkop_section');
			uci.commit('awg-warp-auto');

			command('/etc/init.d/forkop reload 2>/dev/null &');

			return { ok: true, removed: sec };
		}
	}
};

return { 'luci.amneziawg': methods };
