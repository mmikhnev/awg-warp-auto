{
	"luci-proto-amneziawg": {
		"description": "Grant access to LuCI AmneziaWG procedures",
		"read": {
			"ubus": {
				"luci.amneziawg": [
					"getAwgInstances",
					"getWarpAutoStatus",
					"getWarpAutoOperation"
				]
			},
			"uci": [ "ddns", "system", "network" ]
		},
		"write": {
			"ubus": {
				"luci.amneziawg": [
					"generateKeyPair",
					"getPublicAndPrivateKeyFromPrivate",
					"generatePsk",
					"validateAwgConfig",
					"importAwgConfig",
					"createInterface",
					"deleteInterface",
					"restartInterface",
					"exportInterfaceConfig",
					"saveWarpAutoSettings",
					"warpAutoAction"
				]
			}
		}
	}
}
